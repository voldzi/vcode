{
  "name": "vcode-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "pnpm validate:content && astro check && astro build && node scripts/validate-recall-build.mjs && node scripts/validate-catalog-build.mjs && node scripts/validate-contact-build.mjs && pnpm validate:discovery",
    "preview": "astro preview --host 0.0.0.0",
    "check": "pnpm validate:public && pnpm validate:openapi && pnpm validate:content && astro check",
    "validate:public": "node scripts/validate-public-repository.mjs",
    "validate:openapi": "node scripts/validate-openapi.mjs",
    "validate:content": "node scripts/validate-content.mjs",
    "test": "pnpm test:blog && node --test services/analytics/test/*.test.mjs && pnpm test:downloads",
    "test:blog": "node --test services/blog/test/*.test.mjs",
    "blog:moderate": "node services/blog/moderate.mjs",
    "blog:articles": "node services/blog/articles.mjs",
    "blog:validate-sources": "node scripts/validate-blog-sources.mjs",
    "indexnow:submit": "node scripts/submit-indexnow.mjs",
    "telegram:webhook": "node scripts/configure-telegram-webhook.mjs",
    "brand:assets": "node scripts/generate-brand-assets.mjs",
    "test:downloads": "node --test services/downloads/test/*.test.mjs",
    "validate:discovery": "node scripts/validate-discoverability-build.mjs",
    "verify:discovery": "python3 scripts/verify-discoverability.py"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "astro": "7.3.3",
    "fast-xml-parser": "5.11.1",
    "pg": "8.23.0",
    "sharp": "0.35.4",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/pg": "8.23.1",
    "typescript": "6.0.3"
  }
}
