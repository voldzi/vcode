---
import FoldlightSupport from "../../components/FoldlightSupport.astro";
import MilloraSupport from "../../components/MilloraSupport.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { appStoreProducts } from "../../lib/appStore";
export function getStaticPaths() { return appStoreProducts.filter(product => product.id !== "rinklet").map(product => ({ params:{slug:product.storeSlug}, props:{product} })); }
const { product } = Astro.props;
const path = `/podpora/${product.storeSlug}/`;
const alternatePath = `/en/support/${product.storeSlug}/`;
---
<BaseLayout title={`Podpora pro ${product.name} — VCode`} description={`Návody, kontakt a technická podpora pro aplikaci ${product.name}.`} lang="cs" {path} {alternatePath}>
  <section class="support-page"><p class="kicker">Podpora aplikace</p><h1>{product.name}</h1>{product.id === "foldlight" ? <FoldlightSupport lang="cs" /> : product.id === "millora" ? <MilloraSupport lang="cs" /> : <><p class="lead">{product.id === "sibenice" ? "Pomůžeme s ovládáním hry na iPhonu a iPadu, zvukem a přihlášením do Game Center. Verzi pro Apple TV připravujeme. Pokud problém přetrvává, napište nám model zařízení, verzi systému, přibližný čas a kroky, které mu předcházely." : product.id === "nest" ? "Pravidla a první kroky najdete na stránce hry. S ovládáním, zvukem nebo přihlášením do Game Center vám pomůže naše podpora. Napište nám model zařízení, verzi systému a stručný popis problému." : "Nejrychlejší pomoc najdete v návodech. Pokud problém přetrvává, napište nám název zařízení, verzi systému, čas problému a kroky, které mu předcházely."}</p><div class="support-options"><a href={product.id === "nest" || product.id === "sibenice" ? `/aplikace/${product.storeSlug}/#pravidla` : `/navody/aplikace/${product.storeSlug}/`}><strong>{product.id === "nest" || product.id === "sibenice" ? `První hra s ${product.name}` : `Návody pro ${product.name}`}</strong><span>{product.id === "nest" || product.id === "sibenice" ? "Pravidla a ovládání →" : "Ověřené postupy →"}</span></a><a href={`mailto:podpora@zeleznalady.cz?subject=Podpora ${product.name}`}><strong>Napsat podpoře</strong><span>podpora@zeleznalady.cz →</span></a></div></>}<div class="store-links">{product.appStoreUrl && <a class="store-link" href={product.appStoreUrl}>App Store</a>}<a class="store-link" href={product.privacyCs}>Ochrana soukromí</a><a class="store-link" href={`/app-store/${product.storeSlug}/`}>Stránka aplikace</a></div>{product.id !== "foldlight" && <p class="privacy-note">Do zprávy neposílejte hesla, přístupové tokeny ani úplnou historii polohy.</p>}</section>
</BaseLayout>
