---
import FoldlightSupport from "../../../components/FoldlightSupport.astro";
import MilloraSupport from "../../../components/MilloraSupport.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { appStoreProducts } from "../../../lib/appStore";
export function getStaticPaths() { return appStoreProducts.filter(product => product.id !== "rinklet").map(product => ({ params:{slug:product.storeSlug}, props:{product} })); }
const { product } = Astro.props;
const path = `/en/support/${product.storeSlug}/`;
const alternatePath = `/podpora/${product.storeSlug}/`;
---
<BaseLayout title={`${product.name} support — VCode`} description={`Guides, contact and technical support for ${product.name}.`} lang="en" {path} {alternatePath}>
  <section class="support-page"><p class="kicker">App support</p><h1>{product.name}</h1>{product.id === "foldlight" ? <FoldlightSupport lang="en" /> : product.id === "millora" ? <MilloraSupport lang="en" /> : <><p class="lead">{product.id === "sibenice" ? "We can help with gameplay on iPhone and iPad, sound and Game Center sign-in. An Apple TV version is in preparation. If a problem persists, email us your device model, system version, approximate time and the steps that led to it." : product.id === "nest" ? "Find the rules and first steps on the game page. Our support can help with controls, sound or Game Center sign-in. Email us your device model, system version and a short description of the issue." : "Verified guides are the fastest way to get help. If a problem persists, email us with your device, system version, the approximate time and the steps that led to it."}</p><div class="support-options"><a href={product.id === "nest" || product.id === "sibenice" ? `/en/apps/${product.storeSlug}/#pravidla` : `/en/guides/apps/${product.storeSlug}/`}><strong>{product.id === "nest" || product.id === "sibenice" ? `Your first game with ${product.name}` : `${product.name} guides`}</strong><span>{product.id === "nest" || product.id === "sibenice" ? "Rules and controls →" : "Verified instructions →"}</span></a><a href={`mailto:podpora@zeleznalady.cz?subject=${product.name} support`}><strong>Contact support</strong><span>podpora@zeleznalady.cz →</span></a></div></>}<div class="store-links">{product.appStoreUrl && <a class="store-link" href={product.appStoreUrl}>App Store</a>}<a class="store-link" href={product.privacyEn}>Privacy</a><a class="store-link" href={`/en/app-store/${product.storeSlug}/`}>App page</a></div>{product.id !== "foldlight" && <p class="privacy-note">Never include passwords, access tokens or your complete location history.</p>}</section>
</BaseLayout>
