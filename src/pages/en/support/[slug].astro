---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { appStoreProducts } from "../../../lib/appStore";
export function getStaticPaths() { return appStoreProducts.map(product => ({ params:{slug:product.storeSlug}, props:{product} })); }
const { product } = Astro.props;
const path = `/en/support/${product.storeSlug}/`;
const alternatePath = `/podpora/${product.storeSlug}/`;
---
<BaseLayout title={`${product.name} support — VCode`} description={`Guides, contact and technical support for ${product.name}.`} lang="en" {path} {alternatePath}>
  <section class="support-page"><p class="kicker">App support</p><h1>{product.name}</h1><p class="lead">Verified guides are the fastest way to get help. If the problem persists, email us with your device, system version, the approximate time and the steps that led to it.</p><div class="support-options"><a href={`/en/guides/apps/${product.storeSlug}/`}><strong>{product.name} guides</strong><span>Verified instructions →</span></a><a href={`mailto:podpora@zeleznalady.cz?subject=${product.name} support`}><strong>Contact support</strong><span>podpora@zeleznalady.cz →</span></a></div><div class="store-links"><a class="store-link" href={product.privacyEn}>Privacy</a><a class="store-link" href={`/en/app-store/${product.storeSlug}/`}>App page</a></div><p class="privacy-note">Never include passwords, access tokens or your complete location history.</p></section>
</BaseLayout>
