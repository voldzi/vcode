import BaseLayout from "../../layouts/BaseLayout.astro";
---
<BaseLayout title="Privacy — VCode" description="How VCode handles data on the website and in technology blog comments." lang="en" path="/en/privacy/" alternatePath="/soukromi/">
  <article class="guide">
    <a class="back-link" href="/en/">← VCode</a>
    <header><p class="kicker">Privacy</p><h1>Only the data the service needs.</h1><p>You can read the website without an account. We process personal data only when you contact support or submit a comment.</p></header>
    <div class="guide-body">
      <h2>Blog comments</h2><p>For a comment, we store the chosen display name, text, time and technical data needed to protect the discussion. Email is optional and stored only as a one-way hash. We protect the IP address in the same way and never display it publicly.</p>
      <h2>Moderation</h2><p>Comment text may be assessed automatically by OpenAI to detect harmful or illegal content. If automated review is unavailable or uncertain, the comment waits for manual review. We do not publish comments identified as spam.</p>
      <h2>Retention</h2><p>Pending, rejected and spam comments are deleted within 90 days. Published comments remain with the article until you ask us to remove them or the discussion no longer serves its purpose.</p>
      <h2>Your requests</h2><p>To request correction or removal, contact <a href="mailto:podpora@zeleznalady.cz"><strong>podpora@zeleznalady.cz</strong></a>. Include the article address, display name and approximate submission time; never send passwords or other sensitive information.</p>
    </div>
  </article>
</BaseLayout>
