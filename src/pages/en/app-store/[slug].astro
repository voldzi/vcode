---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ProductIcon from "../../../components/ProductIcon.astro";
import { appStoreProducts } from "../../../lib/appStore";
export function getStaticPaths() { return appStoreProducts.map(product => ({ params: { slug: product.storeSlug }, props: { product } })); }
const { product } = Astro.props;
const path = `/en/app-store/${product.storeSlug}/`;
const alternatePath = `/app-store/${product.storeSlug}/`;
const pageStructuredData = { "@context":"https://schema.org", "@type":"MobileApplication", name:product.name, description:product.summaryEn, operatingSystem:"iOS", applicationCategory:product.categoryEn, url:new URL(path, Astro.site).href, publisher:{"@type":"Organization",name:"VCode"} };
---
<BaseLayout title={`${product.name} for iPhone — VCode`} description={product.summaryEn} lang="en" {path} {alternatePath} {pageStructuredData}>
  <div class:list={["app-store-page", `tone-${product.tone}`]}>
    <section class="app-store-hero">
      <div><p class="kicker">iPhone app</p><h1>{product.name}</h1><p class="detail-headline">{product.headlineEn}</p><p class="lead">{product.summaryEn}</p><div class="store-links"><a class="button primary" href={product.supportEn}>App support</a><a class="store-link" href={product.privacyEn}>Privacy</a></div></div>
      <div class="app-store-emblem"><ProductIcon id={product.id} size={180}/></div>
    </section>
    <div class="app-store-content">
      <section><h2>Everything that matters, together</h2><ul>{product.capabilitiesEn.map(item => <li>{item}</li>)}</ul></section>
      <section class="app-store-meta"><h2>Information and help</h2><p>{product.availabilityEn}</p><a href={product.supportEn}>Technical support →</a><a href={product.privacyEn}>Privacy information →</a><a href={`/en/apps/${product.href}/`}>More about the app →</a></section>
    </div>
  </div>
</BaseLayout>
