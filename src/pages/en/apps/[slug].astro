---
import GameShowcase from "../../../components/GameShowcase.astro";
import StratosShowcase from "../../../components/StratosShowcase.astro";
import StudioBalanceShowcase from "../../../components/StudioBalanceShowcase.astro";
import MasazeShowcase from "../../../components/MasazeShowcase.astro";
import EventShowcase from "../../../components/EventShowcase.astro";
import JizdaShowcase from "../../../components/JizdaShowcase.astro";
import { eventScreenshots } from "../../../lib/event-showcase";
import { masazeScreenshots } from "../../../lib/masaze-showcase";
import { studioScreenshots } from "../../../lib/studio-balance-showcase";
import { getGameShowcase, getShowcaseHero } from "../../../lib/game-showcases";
import RecallHero from "../../../components/RecallHero.astro";
import RecallDownloads from "../../../components/RecallDownloads.astro";
import RecallDetails from "../../../components/RecallDetails.astro";
import MestemHrouShowcase from "../../../components/MestemHrouShowcase.astro";
import MojePorceShowcase from "../../../components/MojePorceShowcase.astro";
import { mojePorceScreenshots } from "../../../lib/moje-porce-showcase";
import AppStoreBadge from "../../../components/AppStoreBadge.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getPublicProducts } from "../../../lib/products";
import { appStoreProducts } from "../../../lib/appStore";
export function getStaticPaths() { return getPublicProducts().map(product => ({ params: { slug: product.href }, props: { product } })); }
const { product } = Astro.props;
const name = product.nameEn ?? product.name;
const showcase = getGameShowcase(product.id);
const operationsHero = product.id === "studio-balance" ? studioScreenshots[0] : product.id === "masaze" ? masazeScreenshots[0] : product.id === "event" ? eventScreenshots[0] : undefined;
const mojePorceHero = product.id === "kaloricke-tabulky" ? mojePorceScreenshots[0] : undefined;
const socialPreview = mojePorceHero ? { src: mojePorceHero.src, width: mojePorceHero.width, height: mojePorceHero.height, alt: mojePorceHero.captionEn } : product.id === "jizda" ? { src: "/apps/jizda.webp", width: 512, height: 512, alt: "Jízda" } : showcase ? getShowcaseHero(showcase, "en") : operationsHero ? { src: operationsHero.src, width: operationsHero.width, height: operationsHero.height, alt: operationsHero.captionEn } : undefined;
const storeProduct = appStoreProducts.find(item => item.id === product.id);
const family = product.family ? getPublicProducts().filter(item => item.family === product.family && item.id !== product.id) : [];
const pageStructuredData = {
  "@context": "https://schema.org", "@type": product.kind === "game" ? "VideoGame" : "SoftwareApplication",
  "@id": `https://vcode.zeleznalady.cz/en/apps/${product.href}/#application`,
  name: name, description: product.summaryEn, inLanguage: "en",
  applicationCategory: product.kind === "game" ? "GameApplication" : product.categoryEn,
  url: `https://vcode.zeleznalady.cz/en/apps/${product.href}/`,
  ...(socialPreview ? { image: new URL(socialPreview.src, Astro.site).href } : {}),
  ...(storeProduct?.appStoreUrl ? { downloadUrl: storeProduct.appStoreUrl, operatingSystem: storeProduct.operatingSystem ?? "iOS" } : {}),
  publisher: { "@id": "https://vcode.zeleznalady.cz/#organization" }
};
---
<BaseLayout title={`${name} — VCode`} description={product.summaryEn} lang="en" path={`/en/apps/${product.href}/`} alternatePath={`/aplikace/${product.href}/`} {pageStructuredData} {socialPreview}>
  {product.family === "stratos" ? <StratosShowcase {product} lang="en" /> : <article class:list={["product-detail", `tone-${product.tone}`, {"mestem-hrou-detail": product.id === "mestem-hrou", "game-product-detail": Boolean(showcase), "studio-balance-detail": product.id === "studio-balance", "masaze-operator-detail": product.id === "masaze", "event-showcase-detail": product.id === "event", "jizda-showcase-detail": product.id === "jizda", "moje-porce-showcase-detail": product.id === "kaloricke-tabulky"}]}>
    <a class="back-link" href={product.kind === "game" ? "/en/games/" : "/en/#apps"}>← {product.kind === "game" ? "All games" : "All apps"}</a>
    {showcase && <GameShowcase {product} {showcase} {storeProduct} lang="en" />}
    {product.id === "studio-balance" && <StudioBalanceShowcase lang="en" />}
    {product.id === "masaze" && <MasazeShowcase lang="en" />}
    {product.id === "event" && <EventShowcase lang="en" />}
    {product.id === "jizda" && <JizdaShowcase {product} {storeProduct} lang="en" />}
    {!showcase && !["studio-balance", "masaze", "event", "jizda", "kaloricke-tabulky"].includes(product.id) && (product.id === "vcode-recall" ? <RecallHero {product} lang="en" guideHref="/en/guides/vcode-recall-first-time-setup/" released={true} /> : <header><p class="kicker">{product.categoryEn}</p><h1>{name}</h1><p class="detail-headline">{product.headlineEn}</p>{product.id !== "mestem-hrou" && <p class="detail-summary">{product.summaryEn}</p>}</header>)}
    {product.id === "mestem-hrou" && <MestemHrouShowcase {product} lang="en" />}
    {!showcase && !["vcode-recall", "mestem-hrou", "studio-balance", "masaze", "event", "jizda", "kaloricke-tabulky"].includes(product.id) && <div class="detail-grid"><section><h2>What it does</h2><ul>{product.capabilitiesEn.map(item => <li>{item}</li>)}</ul></section><aside><span>Availability</span><strong>{product.availabilityEn}</strong>{storeProduct?.appStoreUrl && <AppStoreBadge href={storeProduct.appStoreUrl} lang="en" />}{storeProduct && <a class="store-link" href={`/en/app-store/${storeProduct.storeSlug}/`}>About the app</a>}{product.externalUrl && !product.startUrl && <a class="store-link" href={product.externalUrlEn ?? product.externalUrl}>Open the app <span aria-hidden="true">↗</span></a>}{product.startUrl && <a class="button primary" href={product.startUrl}>Try it free <span aria-hidden="true">↗</span></a>}{product.learnMoreUrl && <a class="store-link" href={product.learnMoreUrl}>How it works <span aria-hidden="true">↗</span></a>}</aside></div>}
    {["apsyd", "apsyd-central"].includes(product.id) && <section class="detail-support"><h2>Related APSYD applications</h2><p><a class="text-link" href={product.id === "apsyd" ? "/en/apps/apsyd-central/" : "/en/apps/apsyd/"}>{product.id === "apsyd" ? "APSYD Central" : "APSYD"} →</a></p></section>}
    {product.id === "stratos-voice" && <section class="detail-support"><h2>Support and privacy</h2><p><a class="text-link" href="/en/support/stratos-voice/">Help with recording, transcription and AI →</a></p><p><a class="text-link" href="/en/stratos-voice/privacy/">How STRATOS Voice handles data →</a></p></section>}
    {!showcase && product.id === "millora" && storeProduct && <section class="detail-support"><h2>Support and privacy</h2><p><a class="text-link" href={storeProduct.supportEn}>Help with rules and online play →</a></p><p><a class="text-link" href={storeProduct.privacyEn}>How MILLORA handles data →</a></p></section>}
    {product.id === "vcode-recall" && <><RecallDownloads lang="en" /><RecallDetails released={true} lang="en" guideHref="/en/guides/vcode-recall-first-time-setup/" /></>}
    {product.id === "kaloricke-tabulky" && <MojePorceShowcase lang="en" />}
    {family.length > 0 && <section class="family-links"><h2>More from the STRATOS family</h2><div>{family.map(item => <a href={`/en/apps/${item.href}/`}>{item.nameEn ?? item.name}<span aria-hidden="true">→</span></a>)}</div></section>}
    {!showcase && !product.inDevelopment && !["studio-balance", "masaze", "event", "jizda", "kaloricke-tabulky"].includes(product.id) && (!product.family || product.id === "stratos") && <section class="detail-support"><h2>Getting started?</h2><p>Find step-by-step guides, answers and privacy information in the help centre.</p><a class="text-link" href={`/en/guides/apps/${product.href}/`}>Guides for {name} →</a></section>}
  </article>}
</BaseLayout>
