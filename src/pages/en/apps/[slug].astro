---
import RecallHero from "../../../components/RecallHero.astro";
import RecallDownloads from "../../../components/RecallDownloads.astro";
import RecallDetails from "../../../components/RecallDetails.astro";
import MestemHrouShowcase from "../../../components/MestemHrouShowcase.astro";
import MojePorceDetails from "../../../components/MojePorceDetails.astro";
import AppStoreBadge from "../../../components/AppStoreBadge.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getPublicProducts } from "../../../lib/products";
import { appStoreProducts } from "../../../lib/appStore";
export function getStaticPaths() { return getPublicProducts().map(product => ({ params: { slug: product.href }, props: { product } })); }
const { product } = Astro.props;
const name = product.nameEn ?? product.name;
const storeProduct = appStoreProducts.find(item => item.id === product.id);
const family = product.family ? getPublicProducts().filter(item => item.family === product.family && item.id !== product.id) : [];
const pageStructuredData = { "@context": "https://schema.org", "@type": "SoftwareApplication", name, description: product.summaryEn, applicationCategory: product.kind === "game" ? "GameApplication" : product.categoryEn, url: `https://vcode.zeleznalady.cz/en/apps/${product.href}/`, publisher: { "@type": "Organization", name: "VCode" } };
---
<BaseLayout title={`${name} — VCode`} description={product.summaryEn} lang="en" path={`/en/apps/${product.href}/`} alternatePath={`/aplikace/${product.href}/`} {pageStructuredData}>
  <article class:list={["product-detail", `tone-${product.tone}`, {"mestem-hrou-detail": product.id === "mestem-hrou"}]}>
    <a class="back-link" href={product.kind === "game" ? "/en/games/" : "/en/#apps"}>← {product.kind === "game" ? "All games" : "All apps"}</a>
    {product.id === "vcode-recall" ? <RecallHero {product} lang="en" guideHref="/en/guides/vcode-recall-first-time-setup/" released={true} /> : <header><p class="kicker">{product.categoryEn}</p><h1>{name}</h1><p class="detail-headline">{product.headlineEn}</p>{product.id !== "mestem-hrou" && <p class="detail-summary">{product.summaryEn}</p>}</header>}
    {product.id === "mestem-hrou" && <MestemHrouShowcase {product} lang="en" />}
    {!["vcode-recall", "mestem-hrou"].includes(product.id) && <div class="detail-grid"><section><h2>What it does</h2><ul>{product.capabilitiesEn.map(item => <li>{item}</li>)}</ul></section><aside><span>Availability</span><strong>{product.availabilityEn}</strong>{storeProduct?.appStoreUrl && <AppStoreBadge href={storeProduct.appStoreUrl} lang="en" />}{storeProduct && <a class="store-link" href={`/en/app-store/${storeProduct.storeSlug}/`}>About the app</a>}{product.externalUrl && !product.startUrl && <a class="store-link" href={product.externalUrlEn ?? product.externalUrl}>Open the app <span aria-hidden="true">↗</span></a>}{product.startUrl && <a class="button primary" href={product.startUrl}>Try it free <span aria-hidden="true">↗</span></a>}{product.learnMoreUrl && <a class="store-link" href={product.learnMoreUrl}>How it works <span aria-hidden="true">↗</span></a>}{product.id === "event" && <a class="button primary" href="/en/support/">Arrange a demo</a>}</aside></div>}
    {["apsyd", "apsyd-central"].includes(product.id) && <section class="detail-support"><h2>Related APSYD applications</h2><p><a class="text-link" href={product.id === "apsyd" ? "/en/apps/apsyd-central/" : "/en/apps/apsyd/"}>{product.id === "apsyd" ? "APSYD Central" : "APSYD"} →</a></p></section>}
    {product.id === "stratos-voice" && <section class="detail-support"><h2>Support and privacy</h2><p><a class="text-link" href="/en/support/stratos-voice/">Help with recording, transcription and AI →</a></p><p><a class="text-link" href="/en/stratos-voice/privacy/">How STRATOS Voice handles data →</a></p></section>}
    {product.id === "millora" && storeProduct && <section class="detail-support"><h2>Support and privacy</h2><p><a class="text-link" href={storeProduct.supportEn}>Help with rules and online play →</a></p><p><a class="text-link" href={storeProduct.privacyEn}>How MILLORA handles data →</a></p></section>}
    {product.id === "vcode-recall" && <><RecallDownloads lang="en" /><RecallDetails released={true} lang="en" guideHref="/en/guides/vcode-recall-first-time-setup/" /></>}
    {product.id === "kaloricke-tabulky" && <MojePorceDetails lang="en" />}
    {product.id === "foldlight" && <section class="detail-support"><h2>The fold becomes a control</h2><p>Opening the pages changes the path of light. Mirrors reflect it and flowers open when illuminated. The short showcase explores iPhone Duo; on ordinary devices, touch controls offer the same principle. The game has not yet been released on the App Store.</p></section>}
    {family.length > 0 && <section class="family-links"><h2>More from the STRATOS family</h2><div>{family.map(item => <a href={`/en/apps/${item.href}/`}>{item.nameEn ?? item.name}<span aria-hidden="true">→</span></a>)}</div></section>}
    {!product.inDevelopment && (!product.family || product.id === "stratos") && <section class="detail-support"><h2>Getting started?</h2><p>Find step-by-step guides, answers and privacy information in the help centre.</p><a class="text-link" href={`/en/guides/apps/${product.href}/`}>Guides for {name} →</a></section>}
  </article>
</BaseLayout>
