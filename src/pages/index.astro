---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProductCard from "../components/ProductCard.astro";
import CatalogFilters from "../components/CatalogFilters.astro";
import GamesSection from "../components/GamesSection.astro";
import SignalMark from "../components/SignalMark.astro";
import { getPublicProducts, everydayProducts } from "../lib/products";
---
<BaseLayout title="VCode — technologie, na které je spoleh" description="Navrhujeme užitečné a důvěryhodné digitální produkty pro každodenní život, bezpečnost, zdraví a řízení organizací." lang="cs" path="/">
  <section class="hero">
    <div class="eyebrow"><span></span> Digitální produkty z Česka</div>
    <h1>Technologie,<br/><em>na které je spoleh.</em></h1>
    <p class="hero-copy">Navrhujeme aplikace, které lidem pomáhají rozhodovat se jednoduše, bezpečně a s jistotou — na cestách, v práci i v každodenním životě.</p>
    <div class="hero-actions">
      <a class="button primary" href="#aplikace">Naše aplikace</a>
      <a class="button secondary" href="/spoluprace/" data-collaboration-interest>Proberme váš projekt</a>
    </div>
    <div class="hero-signal" aria-hidden="true"><SignalMark size={230}/></div>
  </section>

  <section class="principles" aria-label="Naše zásady">
    <div><strong>Užitečné</strong><span>Řeší skutečný úkol.</span></div>
    <div><strong>Srozumitelné</strong><span>Bez zbytečných překážek.</span></div>
    <div><strong>Důvěryhodné</strong><span>Data a soukromí bereme vážně.</span></div>
  </section>

  <div data-catalog>
  <section class="products-section" id="aplikace">
    <CatalogFilters lang="cs" />
    <div data-catalog-group>
    <div class="section-heading">
      <div><span class="section-index">01</span><h2>Pro každodenní<br/>život.</h2></div>
      <p>Užitečné aplikace a veřejné služby pro jídlo, pohyb a péči o sebe. Vyberte si to, co vám pomůže právě dnes.</p>
    </div>
    <div class="product-grid">{everydayProducts.map(product => <ProductCard product={product} lang="cs" />)}</div>
    </div>
    <div data-catalog-group>
    <div class="family-heading"><span class="section-index">PORTFOLIO</span><div><h3>Pro práci a odborné použití.</h3><p>Bezpečnost, zdraví a organizace práce. Veřejné aplikace, připravované produkty i řešení pro soukromé nasazení mají své místo.</p></div></div>
    <div class="product-grid">
      {getPublicProducts().filter(product => !product.family && product.kind !== "game" && !everydayProducts.includes(product)).map((product, index) => <ProductCard product={product} lang="cs" featured={index < 2} />)}
    </div>
    </div>
    <div data-catalog-group>
    <div class="family-heading"><span class="section-index">STRATOS</span><div><h3>Jedna rodina. Samostatné aplikace.</h3><p>Finance, vedení portfolia, realizace projektů, architektura a řízené znalosti mají každé svůj vlastní prostor.</p></div></div>
    <div class="product-grid">
      {getPublicProducts().filter(product => product.family).sort((a, b) => Number(b.id === "stratos") - Number(a.id === "stratos")).map(product => <ProductCard product={product} lang="cs" />)}
    </div>
    </div>
  </section>

  <GamesSection lang="cs" />
  </div>

  <section class="trust-band">
    <span class="section-index">02</span>
    <div><p class="kicker">Jak pracujeme</p><h2>Klidné rozhraní.<br/>Přesná technologie.</h2></div>
    <div class="trust-copy"><p>Rozhraní navrhujeme pro skutečné situace, včetně slabého připojení, malého displeje a chvílí, kdy není prostor přemýšlet nad ovládáním.</p><p>Citlivá data chráníme od návrhu. Automatizace a AI používáme tam, kde pomohou — s viditelným původem, nejistotou a kontrolou člověka.</p></div>
  </section>

  <section class="support-cta">
    <div><span class="section-index">03</span><h2>Potřebujete poradit?</h2><p>Návody pro všechny naše aplikace vznikají na jednom místě, v češtině i angličtině.</p></div>
    <a class="button light" href="/navody/">Otevřít centrum nápovědy <span aria-hidden="true">↗</span></a>
  </section>
</BaseLayout>
