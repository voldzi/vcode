---
import GameShowcase from "../../components/GameShowcase.astro";
import StratosShowcase from "../../components/StratosShowcase.astro";
import StudioBalanceShowcase from "../../components/StudioBalanceShowcase.astro";
import ElectionAnalystShowcase from "../../components/ElectionAnalystShowcase.astro";
import { electionScreenshots } from "../../lib/election-analyst-showcase";
import MasazeShowcase from "../../components/MasazeShowcase.astro";
import EventShowcase from "../../components/EventShowcase.astro";
import JizdaShowcase from "../../components/JizdaShowcase.astro";
import { eventScreenshots } from "../../lib/event-showcase";
import { masazeScreenshots } from "../../lib/masaze-showcase";
import { studioScreenshots } from "../../lib/studio-balance-showcase";
import { getGameShowcase, getShowcaseHero } from "../../lib/game-showcases";
import RecallHero from "../../components/RecallHero.astro";
import RecallDownloads from "../../components/RecallDownloads.astro";
import RecallDetails from "../../components/RecallDetails.astro";
import MestemHrouShowcase from "../../components/MestemHrouShowcase.astro";
import MojePorceShowcase from "../../components/MojePorceShowcase.astro";
import { mojePorceScreenshots } from "../../lib/moje-porce-showcase";
import AppStoreBadge from "../../components/AppStoreBadge.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPublicProducts } from "../../lib/products";
import { appStoreProducts } from "../../lib/appStore";
export function getStaticPaths() { return getPublicProducts().filter(product => product.id !== "ai-v-praci").map(product => ({ params: { slug: product.href }, props: { product } })); }
const { product } = Astro.props;
const showcase = getGameShowcase(product.id);
const operationsHero = product.id === "election-analyst" ? electionScreenshots[0] : product.id === "studio-balance" ? studioScreenshots[0] : product.id === "masaze" ? masazeScreenshots[0] : product.id === "event" ? eventScreenshots[0] : undefined;
const mojePorceHero = product.id === "kaloricke-tabulky" ? mojePorceScreenshots[0] : undefined;
const socialPreview = mojePorceHero ? { src: mojePorceHero.src, width: mojePorceHero.width, height: mojePorceHero.height, alt: mojePorceHero.captionCs } : product.id === "jizda" ? { src: "/apps/jizda.webp", width: 512, height: 512, alt: "Jízda" } : showcase ? getShowcaseHero(showcase, "cs") : operationsHero ? { src: operationsHero.src, width: operationsHero.width, height: operationsHero.height, alt: operationsHero.captionCs } : undefined;
const storeProduct = appStoreProducts.find(item => item.id === product.id);
const family = product.family ? getPublicProducts().filter(item => item.family === product.family && item.id !== product.id) : [];
const pageStructuredData = {
  "@context": "https://schema.org", "@type": product.kind === "game" ? "VideoGame" : "SoftwareApplication",
  "@id": `https://vcode.zeleznalady.cz/aplikace/${product.href}/#application`,
  name: product.name, description: product.summaryCs, inLanguage: "cs",
  applicationCategory: product.kind === "game" ? "GameApplication" : product.categoryCs,
  url: `https://vcode.zeleznalady.cz/aplikace/${product.href}/`,
  ...(socialPreview ? { image: new URL(socialPreview.src, Astro.site).href } : {}),
  ...(storeProduct?.appStoreUrl ? { downloadUrl: storeProduct.appStoreUrl, operatingSystem: storeProduct.operatingSystem ?? "iOS" } : {}),
  publisher: { "@id": "https://vcode.zeleznalady.cz/#organization" }
};
---
<BaseLayout title={`${product.name} — VCode`} description={product.summaryCs} lang="cs" path={`/aplikace/${product.href}/`} alternatePath={`/en/apps/${product.href}/`} {pageStructuredData} {socialPreview}>
  {product.family === "stratos" ? <StratosShowcase {product} lang="cs" /> : <article class:list={["product-detail", `tone-${product.tone}`, {"mestem-hrou-detail": product.id === "mestem-hrou", "game-product-detail": Boolean(showcase), "studio-balance-detail": product.id === "studio-balance", "masaze-operator-detail": product.id === "masaze", "election-analyst-detail": product.id === "election-analyst", "event-showcase-detail": product.id === "event", "jizda-showcase-detail": product.id === "jizda", "moje-porce-showcase-detail": product.id === "kaloricke-tabulky"}]}>
    <a class="back-link" href={product.kind === "game" ? "/hry/" : "/#aplikace"}>← {product.kind === "game" ? "Všechny hry" : "Všechny aplikace"}</a>
    {showcase && <GameShowcase {product} {showcase} {storeProduct} lang="cs" />}
    {product.id === "studio-balance" && <StudioBalanceShowcase lang="cs" />}
    {product.id === "election-analyst" && <ElectionAnalystShowcase lang="cs" />}
    {product.id === "masaze" && <MasazeShowcase lang="cs" />}
    {product.id === "event" && <EventShowcase lang="cs" />}
    {product.id === "jizda" && <JizdaShowcase {product} {storeProduct} lang="cs" />}
    {!showcase && !["studio-balance", "masaze", "event", "jizda", "election-analyst", "kaloricke-tabulky"].includes(product.id) && (product.id === "vcode-recall" ? <RecallHero {product} lang="cs" guideHref="/navody/vcode-recall-prvni-nastaveni/" released={true} /> : <header><p class="kicker">{product.categoryCs}</p><h1>{product.name}</h1><p class="detail-headline">{product.headlineCs}</p>{product.id !== "mestem-hrou" && <p class="detail-summary">{product.summaryCs}</p>}</header>)}
    {product.id === "mestem-hrou" && <MestemHrouShowcase {product} lang="cs" />}
    {!showcase && !["vcode-recall", "mestem-hrou", "studio-balance", "masaze", "event", "jizda", "election-analyst", "kaloricke-tabulky"].includes(product.id) && <div class="detail-grid"><section><h2>Co umí</h2><ul>{product.capabilitiesCs.map(item => <li>{item}</li>)}</ul></section><aside><span>Dostupnost</span><strong>{product.availabilityCs}</strong>{storeProduct?.appStoreUrl && <AppStoreBadge href={storeProduct.appStoreUrl} lang="cs" />}{storeProduct && <a class="store-link" href={`/app-store/${storeProduct.storeSlug}/`}>Informace o aplikaci</a>}{product.externalUrl && !product.startUrl && <a class="store-link" href={product.externalUrl}>Otevřít aplikaci <span aria-hidden="true">↗</span></a>}{product.startUrl && <a class="button primary" href={product.startUrl}>Vyzkoušet zdarma <span aria-hidden="true">↗</span></a>}{product.learnMoreUrl && <a class="store-link" href={product.learnMoreUrl}>Jak to funguje <span aria-hidden="true">↗</span></a>}</aside></div>}
    {["apsyd", "apsyd-central"].includes(product.id) && <section class="detail-support"><h2>Související aplikace APSYD</h2><p><a class="text-link" href={product.id === "apsyd" ? "/aplikace/apsyd-central/" : "/aplikace/apsyd/"}>{product.id === "apsyd" ? "APSYD Central" : "APSYD"} →</a></p></section>}
    {product.id === "stratos-voice" && <section class="detail-support"><h2>Podpora a soukromí</h2><p><a class="text-link" href="/podpora/stratos-voice/">Pomoc s nahráváním, přepisem a AI →</a></p><p><a class="text-link" href="/stratos-voice/privacy/">Jak STRATOS Voice pracuje s údaji →</a></p></section>}
    {!showcase && product.id === "millora" && storeProduct && <section class="detail-support"><h2>Podpora a soukromí</h2><p><a class="text-link" href={storeProduct.supportCs}>Pomoc s pravidly a online hraním →</a></p><p><a class="text-link" href={storeProduct.privacyCs}>Jak MILLORA pracuje s údaji →</a></p></section>}
    {product.id === "vcode-recall" && <><RecallDownloads lang="cs" /><RecallDetails released={true} lang="cs" guideHref="/navody/vcode-recall-prvni-nastaveni/" /></>}
    {product.id === "kaloricke-tabulky" && <MojePorceShowcase lang="cs" />}
    {family.length > 0 && <section class="family-links"><h2>Další aplikace rodiny STRATOS</h2><div>{family.map(item => <a href={`/aplikace/${item.href}/`}>{item.name}<span aria-hidden="true">→</span></a>)}</div></section>}
    {!showcase && !product.inDevelopment && !["studio-balance", "masaze", "event", "jizda", "election-analyst", "kaloricke-tabulky"].includes(product.id) && (!product.family || product.id === "stratos") && <section class="detail-support"><h2>Začínáte?</h2><p>Postupy, odpovědi a informace o soukromí najdete v centru nápovědy.</p><a class="text-link" href={`/navody/aplikace/${product.href}/`}>Návody pro {product.name} →</a></section>}
  </article>}
</BaseLayout>
