---
import MojePorceDetails from "../../components/MojePorceDetails.astro";
import AppStoreBadge from "../../components/AppStoreBadge.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { products } from "../../lib/products";
import { appStoreProducts } from "../../lib/appStore";
export function getStaticPaths() { return products.map(product => ({ params: { slug: product.href }, props: { product } })); }
const { product } = Astro.props;
const storeProduct = appStoreProducts.find(item => item.id === product.id);
const family = product.family ? products.filter(item => item.family === product.family && item.id !== product.id) : [];
const pageStructuredData = { "@context": "https://schema.org", "@type": "SoftwareApplication", name: product.name, description: product.summaryCs, applicationCategory: product.kind === "game" ? "GameApplication" : product.categoryCs, url: `https://vcode.zeleznalady.cz/aplikace/${product.href}/`, publisher: { "@type": "Organization", name: "VCode" } };
---
<BaseLayout title={`${product.name} — VCode`} description={product.summaryCs} lang="cs" path={`/aplikace/${product.href}/`} alternatePath={`/en/apps/${product.href}/`} {pageStructuredData}>
  <article class:list={["product-detail", `tone-${product.tone}`]}>
    <a class="back-link" href={product.kind === "game" ? "/hry/" : "/#aplikace"}>← {product.kind === "game" ? "Všechny hry" : "Všechny aplikace"}</a>
    <header><p class="kicker">{product.categoryCs}</p><h1>{product.name}</h1><p class="detail-headline">{product.headlineCs}</p><p class="detail-summary">{product.summaryCs}</p></header>
    <div class="detail-grid"><section><h2>Co umí</h2><ul>{product.capabilitiesCs.map(item => <li>{item}</li>)}</ul></section><aside><span>Dostupnost</span><strong>{product.availabilityCs}</strong>{storeProduct?.appStoreUrl && <AppStoreBadge href={storeProduct.appStoreUrl} lang="cs" />}{storeProduct && <a class="store-link" href={`/app-store/${storeProduct.storeSlug}/`}>Informace o aplikaci</a>}{product.externalUrl && !product.startUrl && <a class="store-link" href={product.externalUrl}>Otevřít aplikaci <span aria-hidden="true">↗</span></a>}{product.startUrl && <a class="button primary" href={product.startUrl}>Vyzkoušet zdarma <span aria-hidden="true">↗</span></a>}{product.learnMoreUrl && <a class="store-link" href={product.learnMoreUrl}>Jak to funguje <span aria-hidden="true">↗</span></a>}{product.id === "event" && <a class="button primary" href="/podpora/">Domluvit ukázku</a>}</aside></div>
    {product.id === "kaloricke-tabulky" && <MojePorceDetails lang="cs" />}
    {product.id === "foldlight" && <section class="detail-support"><h2>Ohyb se stává ovládáním</h2><p>Rozevřením měníte cestu světla. Zrcadla jej odrážejí a květiny se po osvětlení otevírají. Krátká ukázka zkoumá možnosti iPhonu Duo; na běžných zařízeních můžete stejný princip ovládat dotykem. Hra zatím není vydaná v App Storu.</p></section>}
    {family.length > 0 && <section class="family-links"><h2>Další aplikace rodiny STRATOS</h2><div>{family.map(item => <a href={`/aplikace/${item.href}/`}>{item.name}<span aria-hidden="true">→</span></a>)}</div></section>}
    {!product.inDevelopment && (!product.family || product.id === "stratos") && <section class="detail-support"><h2>Začínáte?</h2><p>Postupy, odpovědi a informace o soukromí najdete v centru nápovědy.</p><a class="text-link" href={`/navody/aplikace/${product.href}/`}>Návody pro {product.name} →</a></section>}
  </article>
</BaseLayout>
