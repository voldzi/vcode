---
const { lang = "cs", guideHref, released = false } = Astro.props as { lang?: "cs" | "en"; guideHref?: string; released?: boolean };
const cs = lang === "cs";
const copy = cs ? {
  eyebrow: "KONTEXT, KTERÝ NAVAZUJE",
  title: "Dobrý začátek dalšího rozhovoru.",
  intro: "Rozhodnutí v dokumentaci, souvislosti ve zdrojových souborech, aktuální změny ve zdrojích. Recall z vybraných složek vytváří místní vyhledávací index a zpřístupňuje nalezený kontext vašemu AI klientovi.",
  caption: "Ilustrace přehledu projektů.",
  imageAlt: "Ilustrace přehledu VCode Recall: místní prostředí, připravenost vyhledávání a tři smyšlené projekty.",
  benefits: [
    ["01", "Vyberete, co má být dostupné", "Přidáte konkrétní místní složky. Dokumentace a zdrojové soubory se zpracují na Macu; instalace nezačne sama procházet vaše projekty."],
    ["02", "Kontext pro Codex a Claude Code", "Přes MCP může připojený klient hledat v určeném projektu a získat kontext nalezených souborů. Připojení vždy nastavujete sami."],
    ["03", "Vidíte, kdy je potřeba obnovit index", "Přehled ukazuje stav projektů, odezvu a dostupnost služby. Změněné zdroje zpracujete přírůstkovou indexací."],
    ["04", "Vše potřebné v jedné instalaci", `${released ? "Recall obsahuje" : "Připravovaná aplikace bude obsahovat"} nástroje pro místní vyhledávání. Další prostředí nemusíte nastavovat.`]
  ],
  flowTitle: "Od složky ke kontextu ve třech krocích",
  flow: [
    ["Vaše vybrané složky", "Dokumentace a zdrojové soubory"],
    ["VCode Recall na Macu", "Místní index a vyhledávání"],
    ["Váš připojený AI klient", "Nalezený kontext přes MCP"]
  ],
  boundary: "Indexace a vyhledávání běží místně. S obsahem předaným AI klientovi dál zachází daný klient a jeho poskytovatel podle svých nastavení a podmínek. Vyberte jen projekty, u kterých je takové použití povolené.",
  firstTitle: "První projekt bez nastavování vývojového prostředí",
  firstText: `${released ? "Aplikaci" : "Po vydání aplikaci"} přesunete do Aplikací a dokončíte úvodního průvodce. Potom vyberete složku, vytvoříte vyhledávací index a připojíte svého AI klienta. Spouštění po přihlášení je volitelné.`,
  guide: "Celý návod od instalace po aktualizaci",
  specs: [["Platforma", "Mac s Apple Silicon"], ["Systém", "macOS 26 nebo novější*"], ["Rozhraní", "Čeština a angličtina"], ["Ovládání", "Řádek nabídek a přehled"]],
  requirementsNote: "* Požadavky aktuální verze najdete u balíčku ke stažení.",
  statusTitle: "Distribuci připravujeme",
  statusText: "Instalační balíček bude zdarma. Veřejné stažení zatím není uvolněné. Verzi, sestavu, velikost balíčku a ověřený otisk uvedeme až po dokončení schvalování konkrétního instalátoru.",
  faqTitle: "Než začnete",
  answers: [
    ["Je aplikace open source?", `Vlastní zdrojový kód VCode Recall není zveřejněný. Aplikace obsahuje open source komponenty, které mají své vlastní licence. ${released ? "Jejich přehled najdete v Nastavení → Licence a komponenty a v podkladech přijaté distribuce." : "Povinné licenční informace a případné požadované zdrojové podklady zpřístupníme s přijatou distribucí. Dokončení tohoto přehledu je součástí schvalování vydání."}`],
    ["Je Recall samostatný chat nebo AI model?", "Recall připravuje a vyhledává kontext v projektech. Není náhradou Codexu, Claude Code ani jejich modelů. Přibalený embeddingový model slouží k indexaci a hledání; volitelná generativní diagnostika je samostatná funkce."],
    ["Potřebuji trvalé připojení k internetu?", "Nativní indexace a místní vyhledávání používají přibalený model. Internet potřebujete pro stažení aplikace a ruční kontrolu nových verzí. Připojený AI klient může mít vlastní nároky na připojení a účet."],
    ["Znamená zelený stav služby, že je vše připravené?", "Samotná dostupnost služby nepotvrzuje kvalitu ani aktuálnost výsledků. Nejdříve zaindexujte projekt a ověřte vyhledávání na známém souboru. Přehled tyto stavy rozlišuje."],
    ["Bude aplikace aktualizace instalovat sama?", "Ne. Kontrolu nové verze spouštíte ručně a balíček sami stáhnete. Před výměnou aplikace pozastavíte její vlastní službu; novou verzi prostředí připravíte a aktivujete v průvodci."],
    ["Mohu zachovat stávající Chroma prostředí?", "Ano, existující profil má vlastní postup. Běžná nativní aktualizace zachovává data a embeddingový profil. Přechod z Dockeru nebo změna modelu vyžaduje samostatnou potvrzenou migraci, novou indexaci a ověření klientů."],
    ["Mohu přejmenovat starou ChromaStatusBar.app?", "Běžící aplikaci nepřejmenovávejte. Služby a MCP klienti mohou používat její přesnou cestu. Pro přechod na název VCode Recall je potřeba řízený postup pro konkrétní instalaci."]
  ]
} : {
  eyebrow: "CONTEXT YOU CAN RETURN TO",
  title: "A useful starting point for the next conversation.",
  intro: "Decisions in documentation, connections in source files, current changes in source files. Recall builds a local retrieval index from selected folders and makes retrieved context available to your AI client.",
  caption: "Illustration of the project overview.",
  imageAlt: "Illustration of the VCode Recall overview: local runtime, retrieval readiness and three fictional projects.",
  benefits: [
    ["01", "Choose what becomes available", "Add specific local folders. Documentation and source files are processed on your Mac; installation does not automatically scan your projects."],
    ["02", "Context for Codex and Claude Code", "Through MCP, a connected client can search a selected project and retrieve file context. You configure each connection yourself."],
    ["03", "See when an index needs attention", "The overview shows project status, latency and service availability. Process changed sources with incremental indexing."],
    ["04", "Everything you need in one installation", `${released ? "Recall includes" : "The planned app will include"} the tools for local search, with no extra environment to configure.`]
  ],
  flowTitle: "From a folder to useful context in three steps",
  flow: [
    ["Your selected folders", "Documentation and source files"],
    ["VCode Recall on your Mac", "Local indexing and retrieval"],
    ["Your connected AI client", "Retrieved context through MCP"]
  ],
  boundary: "Indexing and retrieval run locally. Once content is passed to an AI client, that client and its provider handle it according to their own settings and terms. Select only projects for which this use is permitted.",
  firstTitle: "Your first project without setting up a development environment",
  firstText: `${released ? "Move the app" : "After release, move the app"} to Applications and complete the setup assistant. Then choose a folder, create a search index and connect your AI client. Startup at login is optional.`,
  guide: "The complete guide, from installation to updates",
  specs: [["Platform", "Apple Silicon Mac"], ["System", "macOS 26 or later*"], ["Interface", "English and Czech"], ["Controls", "Menu bar and dashboard"]],
  requirementsNote: "* See the download section for the current version’s requirements.",
  statusTitle: "Distribution is in preparation",
  statusText: "The installer will be available free of charge. Public downloads have not been released. The version, build, package size and verified checksum will be stated after acceptance of the specific installer.",
  faqTitle: "Before you start",
  answers: [
    ["Is the app open source?", `VCode Recall's own source code is not published. It includes open source components with their own licenses. ${released ? "Find the inventory in Settings → Licenses and components and in the accepted distribution's supporting materials." : "Required license information and any required corresponding sources will be made available with the accepted distribution. Completing this inventory is part of release acceptance."}`],
    ["Is Recall a standalone chat or AI model?", "Recall indexes and retrieves project context. It does not replace Codex, Claude Code or their models. Its bundled embedding model is used for indexing and retrieval; optional generative diagnostics are a separate feature."],
    ["Do I need a permanent internet connection?", "Native indexing and local retrieval use the bundled model. You need internet access to download the app and manually check for new releases. A connected AI client may have its own account and connectivity requirements."],
    ["Does a healthy service mean everything is ready?", "Service availability alone does not establish result quality or freshness. First index a project and verify retrieval on a familiar file. The overview distinguishes these states."],
    ["Will the app install updates automatically?", "No. You check for a new version manually and download the package yourself. Pause the app's own service before replacing it, then prepare and activate the new runtime in the assistant."],
    ["Can I keep my existing Chroma environment?", "Yes, an existing profile has its own procedure. Ordinary native updates preserve data and the embedding profile. Docker or model migrations require separate confirmation, new indexing and client verification."],
    ["Can I rename the old ChromaStatusBar.app?", "Do not rename a running application. Services and MCP clients may use its exact path. Moving to the VCode Recall name requires a controlled procedure for the specific installation."]
  ]
};
---
<section class="recall-introduction detail-support" aria-labelledby={`recall-context-${lang}`}>
  <p class="recall-eyebrow">{copy.eyebrow}</p>
  <h2 id={`recall-context-${lang}`}>{copy.title}</h2>
  <p class="recall-lead">{copy.intro}</p>
  <figure class="recall-figure">
    <img src={`/images/products/recall-overview-${lang}.webp`} alt={copy.imageAlt} width="1600" height="1120" loading="lazy" decoding="async" />
    <figcaption>{copy.caption}</figcaption>
  </figure>
  <div class="recall-benefits">
    {copy.benefits.map(([number, title, text]) => <article class="recall-benefit"><span class="recall-number" aria-hidden="true">{number}</span><h3>{title}</h3><p>{text}</p></article>)}
  </div>
</section>
<section class="detail-support" aria-labelledby={`recall-flow-${lang}`}>
  <h2 id={`recall-flow-${lang}`}>{copy.flowTitle}</h2>
  <ol class="recall-flow">{copy.flow.map(([title, text]) => <li><strong>{title}</strong><span>{text}</span></li>)}</ol>
  <p class="recall-boundary">{copy.boundary}</p>
</section>
<section class="detail-support recall-start" aria-labelledby={`recall-start-${lang}`}>
  <div><h2 id={`recall-start-${lang}`}>{copy.firstTitle}</h2><p>{copy.firstText}</p>{guideHref && <a class="text-link" href={guideHref}>{copy.guide} <span aria-hidden="true">→</span></a>}</div>
  <div class="recall-specs"><dl>{copy.specs.map(([term, description]) => <div><dt>{term}</dt><dd>{description}</dd></div>)}</dl><p>{copy.requirementsNote}</p></div>
</section>
{!released && <section class="recall-status detail-support" aria-labelledby={`recall-availability-${lang}`}>
  <span class="recall-status-dot" aria-hidden="true"></span><div><h2 id={`recall-availability-${lang}`}>{copy.statusTitle}</h2><p>{copy.statusText}</p></div>
</section>}
<section class="detail-support" aria-labelledby={`recall-faq-${lang}`}>
  <h2 id={`recall-faq-${lang}`}>{copy.faqTitle}</h2>
  {copy.answers.map(([question, answer]) => <details class="recall-answer"><summary>{question}</summary><p>{answer}</p></details>)}
</section>
<style>
  .detail-support { min-width:0; overflow-wrap:anywhere; }
  .detail-support :is(h2,h3,p,li,dd,dt,summary) { min-width:0; }
  .detail-support .text-link { width:auto; max-width:100%; flex-wrap:wrap; }
  .recall-eyebrow { color:#096567; letter-spacing:.12em; font-size:.75rem; font-weight:750; margin-bottom:.9rem; }
  .recall-introduction h2 { max-width:25ch; font-size:clamp(1.7rem,4vw,2.7rem); line-height:1.18; letter-spacing:-.03em; }
  .recall-lead { max-width:70ch; font-size:1.08rem; line-height:1.8; color:var(--muted); }
  .recall-figure { margin:2.5rem 0; }
  .recall-figure img { display:block; width:100%; height:auto; border-radius:1.25rem; border:1px solid var(--line); box-shadow:0 16px 40px rgb(23 58 77 / .07); }
  .recall-figure figcaption { color:var(--muted); font-size:.85rem; line-height:1.6; padding:.85rem .25rem 0; }
  .recall-benefits { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:1rem; }
  .recall-benefit { padding:1.7rem; border:1px solid var(--line); border-radius:1rem; background:linear-gradient(135deg,#f3faf8,#f7f9fe); }
  .recall-number { display:inline-grid; place-items:center; width:2.3rem; height:2.3rem; font-size:.78rem; font-weight:750; color:#075553; background:#d9eeeb; border-radius:.7rem; margin-bottom:.8rem; }
  .recall-benefit h3 { font-size:1.08rem; line-height:1.5; margin:0 0 .65rem; }
  .recall-benefit p { color:var(--muted); margin:0; line-height:1.75; }
  .recall-flow { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:1rem; padding:0; counter-reset:recall-step; list-style:none; margin:1.6rem 0; }
  .recall-flow li { counter-increment:recall-step; padding:1.35rem; border:1px solid var(--line); border-radius:1rem; display:grid; align-content:start; gap:.55rem; }
  .recall-flow li::before { content:counter(recall-step,decimal-leading-zero); font-weight:750; font-size:.8rem; color:#096567; }
  .recall-flow strong { line-height:1.5; }
  .recall-flow span { color:var(--muted); font-size:.9rem; line-height:1.6; }
  .recall-boundary { border-left:3px solid #167b78; padding:.25rem 0 .25rem 1.2rem; color:var(--muted); max-width:80ch; line-height:1.8; }
  .recall-start { display:grid; grid-template-columns:minmax(0,1.3fr) minmax(0,1fr); gap:2.5rem; }
  .recall-start h2 { line-height:1.4; }
  .recall-start p { color:var(--muted); line-height:1.8; }
  .recall-specs { border:1px solid var(--line); border-radius:1rem; padding:1.25rem; align-self:start; background:#fbfcfe; }
  .recall-specs dl { margin:0; display:grid; gap:1rem; }
  .recall-specs dl > div { display:grid; grid-template-columns:minmax(0,.85fr) minmax(0,1.4fr); gap:.75rem; font-size:.9rem; line-height:1.6; }
  .recall-specs dt { color:var(--muted); }
  .recall-specs dd { margin:0; font-weight:650; }
  .recall-specs > p { font-size:.8rem; margin:1rem 0 0; }
  .recall-status { display:flex; gap:1rem; background:#f1f6fc; border:1px solid #d9e6f3; padding:1.6rem; border-radius:1rem; }
  .recall-status > div { min-width:0; }
  .recall-status h2 { font-size:1.1rem; margin:0 0 .5rem; }
  .recall-status p { color:var(--muted); margin:0; line-height:1.8; }
  .recall-status-dot { width:.75rem; height:.75rem; background:#336b9f; border-radius:50%; flex-shrink:0; margin-top:.45rem; }
  .recall-answer { border-top:1px solid var(--line); padding:1rem 0; }
  .recall-answer summary { font-weight:650; line-height:1.65; cursor:pointer; padding:.15rem 0; }
  .recall-answer p { max-width:75ch; color:var(--muted); margin:1rem 0 0; line-height:1.8; }
  .recall-answer summary:focus-visible { outline:2px solid #096567; outline-offset:4px; border-radius:.25rem; }
  @media (max-width:760px) { .recall-benefits,.recall-flow,.recall-start { grid-template-columns:1fr; } .recall-start { gap:1.25rem; } .detail-support,.recall-benefit,.recall-flow li,.recall-specs { padding:clamp(16px,4vw,28px); } .recall-figure { margin:1.7rem 0; } .recall-specs dl > div { grid-template-columns:minmax(0,1fr); gap:.15rem; } }
  @media (prefers-reduced-motion:no-preference) { .recall-answer summary { transition:color .18s ease; } .recall-answer summary:hover { color:#096567; } }
</style>
