---
import SignalMark from "./SignalMark.astro";
const { lang = "cs", path = "/", alternatePath } = Astro.props;
const cs = lang === "cs";
const toEnglish = (value: string) => `/en${value === "/" ? "/" : value.replace(/^\/aplikace/, "/apps").replace(/^\/navody/, "/guides").replace(/^\/podpora/, "/support")}`;
const toCzech = (value: string) => (value.replace(/^\/en/, "") || "/").replace(/^\/apps/, "/aplikace").replace(/^\/guides/, "/navody").replace(/^\/support/, "/podpora");
const switchHref = alternatePath ?? (cs ? toEnglish(path) : toCzech(path));
---
<header class="site-header">
  <a class="brand" href={cs ? "/" : "/en/"} aria-label={cs ? "VCode – domů" : "VCode – home"}>
    <SignalMark size={34} />
    <span>VCode</span>
  </a>
  <nav id="site-navigation" aria-label={cs ? "Hlavní navigace" : "Main navigation"}>
    <a href={cs ? "/#aplikace" : "/en/#apps"}>{cs ? "Aplikace" : "Apps"}</a>
    <a href={cs ? "/blog/" : "/en/blog/"}>{cs ? "Blog" : "Blog"}</a>
    <a href={cs ? "/navody/" : "/en/guides/"}>{cs ? "Návody" : "Guides"}</a>
    <a href={cs ? "/podpora/" : "/en/support/"}>{cs ? "Podpora" : "Support"}</a>
  </nav>
  <div class="header-actions">
    <a class="language" href={switchHref} hreflang={cs ? "en" : "cs"} aria-label={cs ? "English version" : "Česká verze"}>{cs ? "EN" : "CS"}</a>
    <button class="menu-toggle" type="button" aria-controls="site-navigation" aria-expanded="false" aria-label={cs ? "Otevřít nabídku" : "Open menu"}><span></span><span></span></button>
  </div>
</header>
