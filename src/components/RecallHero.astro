---
import ProductIcon from "./ProductIcon.astro";
import type { Product } from "../lib/products";
const { product, lang = "cs", guideHref, released = false } = Astro.props as { product: Product; lang?: "cs" | "en"; guideHref: string; released?: boolean };
const cs = lang === "cs";
---
<header class="recall-hero">
  <div class="recall-hero-icon"><ProductIcon id="vcode-recall" size={104} /></div>
  <p class="kicker">{cs ? "Místní paměť vašich projektů" : "Local memory for your projects"}</p>
  <h1>VCode Recall</h1>
  <p class="detail-headline">{cs ? product.headlineCs : product.headlineEn}</p>
  <p class="detail-summary">{cs ? product.summaryCs : product.summaryEn}</p>
  <div class="recall-hero-actions"><a class="button primary" href={guideHref}>{cs ? "Projít první nastavení" : "Explore first-time setup"} <span aria-hidden="true">→</span></a>{!released && <span class="recall-preparation">{cs ? "Stažení čeká na schválení vydání" : "Download awaits release acceptance"}</span>}</div>
</header>
<style>
  .recall-hero { position:relative; min-width:0; overflow-wrap:anywhere; border:1px solid #d5e5e5; background:radial-gradient(ellipse at 92% 8%,#d5f0e9,transparent 60%),linear-gradient(145deg,#f4fbfb,#fff); padding:clamp(1.5rem,5vw,3.5rem); border-radius:1.6rem; }
  .recall-hero-icon { margin-bottom:1.5rem; }
  .recall-hero h1 { font-size:clamp(2.6rem,7vw,4.8rem); line-height:1.1; letter-spacing:-.045em; margin:.5rem 0 1rem; }
  .recall-hero .detail-headline { font-size:clamp(1.4rem,3.4vw,2.1rem); max-width:28ch; }
  .recall-hero .detail-summary { max-width:65ch; }
  .recall-hero-actions { display:flex; flex-wrap:wrap; align-items:center; gap:1rem; margin-top:1.7rem; }
  .recall-preparation { font-size:.82rem; font-weight:650; color:#405b68; max-width:25ch; }
  @media (max-width:600px) { .recall-hero { padding:clamp(16px,4vw,28px); border-radius:1rem; } .recall-hero-actions { align-items:flex-start; flex-direction:column; } .recall-preparation { max-width:none; } }
</style>
