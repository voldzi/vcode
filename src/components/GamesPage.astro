---
import BaseLayout from "../layouts/BaseLayout.astro";
import GamesSection from "./GamesSection.astro";
const { lang = "cs" } = Astro.props as { lang?: "cs" | "en" };
const cs = lang === "cs";
---
<BaseLayout title={cs ? "Hry — VCode" : "Games — VCode"} description={cs ? "NEST, Šibenice, Městem hrou, Rajčatová sklizeň, Foldlight, Rinklet a MILLORA. Hry od VCode pro prohlížeč, telefon, tablet, Apple TV i výpravy venku." : "NEST, Šibenice, Play the City, Tomato Harvest, Foldlight, Rinklet and MILLORA. VCode games for browsers, phones, tablets, Apple TV and outdoor adventures."} lang={lang} path={cs ? "/hry/" : "/en/games/"} alternatePath={cs ? "/en/games/" : "/hry/"}>
  <header class="help-hero"><p class="kicker">VCode · {cs ? "Hry" : "Games"}</p><h1>{cs ? "Pojďte si hrát." : "Come and play."}</h1><p>{cs ? "Chvíle pro dobrý tah, malé překvapení nebo výpravu za příběhem. Každá hra má svůj vlastní svět." : "Time for a clever move, a small surprise or a story-led adventure. Each game has a world of its own."}</p><a class="text-link" href="#foldlight">{cs ? "Foldlight: světlo ovládané ohybem ↓" : "Foldlight: light controlled by a fold ↓"}</a></header>
  <GamesSection {lang} hub />
  <section class="foldlight-spotlight" id="foldlight" aria-labelledby="foldlight-title"><div><p class="kicker">Foldlight · {cs ? "Dostupné v App Storu" : "Available on the App Store"}</p><h2 id="foldlight-title">{cs ? "Rozevřete telefon. Nechte světlo rozkvést." : "Open your phone. Let the light bloom."}</h2><p>{cs ? "Dvanáct hlavolamů se světlem, zrcadly a květinami. Na iPhonu a iPadu hrajete dotykem; na podporovaném iPhonu Duo se přehyb a náklon stávají součástí hry. Bez účtu, reklam a připojení." : "Twelve puzzles with light, mirrors and flowers. Play by touch on iPhone and iPad, or make folding and tilt part of the game on a supported iPhone Duo. No account, ads or connection needed."}</p><a class="button primary" href={cs ? "/aplikace/foldlight/" : "/en/apps/foldlight/"}>{cs ? "Poznat Foldlight" : "Explore Foldlight"}</a></div><img src="/apps/foldlight.webp" width="256" height="256" alt={cs ? "Ikona Foldlight: světelný hlavolam" : "Foldlight light puzzle app icon"} loading="lazy" /></section>
</BaseLayout>
