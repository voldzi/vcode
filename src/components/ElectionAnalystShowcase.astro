---
import ProductIcon from "./ProductIcon.astro";
import { electionCopy, electionScreenshots } from "../lib/election-analyst-showcase";
const { lang = "cs" } = Astro.props as { lang?: "cs" | "en" };
const cs = lang === "cs";
const copy = electionCopy[lang];
const appHref = "https://stratos.zeleznalady.cz/ea/";
const contactHref = cs ? "/spoluprace/?app=election-analyst&area=other#poptavka" : "/en/work-with-us/?app=election-analyst&area=other#poptavka";
const hero = electionScreenshots[0];
const guideHref = cs ? "/navody/election-analyst-prvni-kroky/" : "/en/guides/election-analyst-getting-started/";
---
<header class="ea-hero">
  <div class="ea-intro">
    <div class="ea-brand"><ProductIcon id="election-analyst" size={56} /><p class="kicker">{copy.eyebrow}</p></div>
    <h1>{copy.title}</h1><p class="ea-headline">{copy.subtitle}</p><p class="ea-lead">{copy.intro}</p>
    <div class="ea-actions"><a class="button ea-primary" href={appHref}>{copy.open}<span aria-hidden="true">↗</span></a><a class="ea-link" href="#moznosti">{copy.explore}<span aria-hidden="true">↓</span></a></div>
    <p class="ea-action-note">{copy.note}</p>
  </div>
  <a class="ea-hero-image" href="#ukazky" aria-label={copy.galleryTitle}><img src={hero.src} width={hero.width} height={hero.height} alt={cs ? hero.captionCs : hero.captionEn} fetchpriority="high" decoding="async" /><span>{copy.heroCaption}</span></a>
</header>
<ul class="ea-facts" aria-label={cs ? "Atlas v kostce" : "The atlas at a glance"}>{copy.facts.map(([value,label]) => <li><strong>{value}</strong><span>{label}</span></li>)}</ul>
<section id="moznosti" class="ea-section" aria-labelledby="ea-features-title"><div class="ea-section-heading"><p class="kicker">{cs ? "Co můžete prozkoumat" : "What you can explore"}</p><h2 id="ea-features-title">{copy.featuresTitle}</h2><p>{copy.featuresIntro}</p></div><ul class="ea-features">{copy.features.map(([title,text],i) => <li><span class="ea-feature-number" aria-hidden="true">{String(i+1).padStart(2,"0")}</span><h3>{title}</h3><p>{text}</p></li>)}</ul></section>
<section id="ukazky" class="ea-section" aria-labelledby="ea-gallery-title"><div class="ea-section-heading"><p class="kicker">{cs ? "Nahlédněte do aplikace" : "Inside the app"}</p><h2 id="ea-gallery-title">{copy.galleryTitle}</h2><p>{copy.galleryIntro}</p></div><ul class="ea-gallery">{electionScreenshots.map(shot => <li><figure><a href={shot.src} aria-label={`${cs ? shot.titleCs : shot.titleEn} — ${copy.imageAction}`}><div class="ea-gallery-image"><img src={shot.preview} width={shot.width} height={shot.height} alt={cs ? shot.captionCs : shot.captionEn} loading="lazy" decoding="async" /></div><figcaption><h3>{cs ? shot.titleCs : shot.titleEn}<span aria-hidden="true">↗</span></h3><p>{cs ? shot.captionCs : shot.captionEn}</p></figcaption></a></figure></li>)}</ul><p class="ea-gallery-note">{copy.galleryNote}</p></section>
<section class="ea-workflow ea-section" aria-labelledby="ea-workflow-title"><div class="ea-section-heading"><p class="kicker">{cs ? "Jak začít" : "Getting started"}</p><h2 id="ea-workflow-title">{copy.workflowTitle}</h2></div><ol>{copy.workflow.map(([title,text]) => <li><h3>{title}</h3><p>{text}</p></li>)}</ol><a class="ea-link" href={appHref}>{copy.open}<span aria-hidden="true">↗</span></a></section>
<p><a class="ea-link" href={guideHref}>{cs ? "Průvodce prvními kroky" : "Getting-started guide"}<span aria-hidden="true">→</span></a></p>
<aside class="ea-context"><h2>{copy.contextTitle}</h2><p>{copy.contextText}</p></aside>
<section class="ea-section ea-faq" aria-labelledby="ea-faq-title"><div class="ea-section-heading"><h2 id="ea-faq-title">{copy.faqTitle}</h2></div>{copy.faq.map(([question,answer]) => <details><summary>{question}</summary><p>{answer}</p></details>)}</section>
<section class="ea-contact" aria-labelledby="ea-contact-title"><p class="kicker">{cs ? "Vaše data a VCode" : "Your data and VCode"}</p><h2 id="ea-contact-title">{copy.contactTitle}</h2><p>{copy.contactText}</p><a class="button" href={contactHref} data-collaboration-interest="true">{copy.contactAction}<span aria-hidden="true">→</span></a></section>
<style>
  :global(.product-detail.election-analyst-detail) {padding-top:clamp(1.5rem,3vw,2.5rem);}
  :global(.election-analyst-detail>.back-link) {margin-bottom:1.25rem;}
  :global(.product-detail.election-analyst-detail header) {max-width:none;}
  .ea-hero {display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,.9fr);gap:1.75rem;max-width:none;}
  .ea-intro {min-width:0;grid-column:1;}
  .ea-brand {display:flex;align-items:center;gap:.85rem;margin-bottom:1rem;}
  .ea-brand .kicker {margin:0;color:#24568c;font-size:.72rem;max-width:24rem;}
  .ea-hero h1 {font-size:4.25rem;line-height:1.05;letter-spacing:0;overflow-wrap:anywhere;}
  .ea-headline {font:750 2.25rem/1.25 "Manrope Variable",sans-serif;letter-spacing:0;color:#24568c;margin:.85rem 0;}
  .ea-lead {font-size:1.04rem;line-height:1.7;max-width:48ch;color:#4d5554;}
  .ea-actions {display:flex;flex-wrap:wrap;align-items:center;gap:.65rem 1rem;margin-top:1.25rem;}
  .ea-primary {background:#24568c;color:#fff;}
  .ea-hero .button,.ea-contact .button {max-width:100%;min-width:0;overflow-wrap:anywhere;white-space:normal;}
  .ea-action-note {font-size:.86rem;color:#4c6279;max-width:48ch;}
  .ea-link {display:inline-flex;align-items:center;gap:.7rem;font-weight:700;color:#24568c;min-height:44px;max-width:100%;line-height:1.5;text-decoration:underline;text-underline-offset:.25em;overflow-wrap:anywhere;}
  .ea-link span {flex:none;}
  .ea-hero-image {align-self:center;min-width:0;}
  .ea-hero-image img {border-radius:.6rem;width:100%;height:auto;}
  .ea-hero-image>span {display:block;text-align:center;color:#4c6279;font-size:.78rem;padding:.65rem .3rem .25rem;}
  .ea-facts {list-style:none;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));padding:1.8rem 0;margin:0;border-bottom:1px solid var(--line);}
  .ea-facts li {min-width:0;display:flex;flex-direction:column;gap:.3rem;padding:.5rem 1.5rem;border-right:1px solid var(--line);}
  .ea-facts li:first-child {padding-left:0;}.ea-facts li:last-child {border:0;}
  .ea-facts strong {font:750 1.4rem/1.3 "Manrope Variable",sans-serif;color:#24568c;overflow-wrap:anywhere;}
  .ea-facts span {font-size:.9rem;color:var(--muted);}
  .ea-section {margin-top:clamp(3rem,6vw,5rem);scroll-margin-top:7rem;}
  .ea-section-heading {max-width:48rem;margin-bottom:1.75rem;}
  h2 {font:750 2.5rem/1.25 "Manrope Variable",sans-serif;letter-spacing:0;color:var(--navy);margin:.5rem 0 1rem;overflow-wrap:anywhere;}
  h3 {font:720 1.08rem/1.4 "Manrope Variable",sans-serif;letter-spacing:0;color:var(--navy);overflow-wrap:anywhere;}
  p,summary,.kicker {overflow-wrap:anywhere;}
  .ea-section-heading>p:last-child {color:var(--muted);max-width:60ch;}
  .ea-features {list-style:none;padding:0;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem;}
  .ea-features li {min-width:0;position:relative;padding:1.6rem 1.6rem 1.2rem;background:#fff;border:1px solid #dce5ef;border-radius:1.15rem;transition:transform .2s ease,border-color .2s ease;}
  .ea-feature-number {display:block;font-size:.78rem;font-weight:750;color:#24568c;margin-bottom:.8rem;}
  .ea-features h3 {margin:0 0 .65rem;}.ea-features p {color:var(--muted);margin:0;line-height:1.7;font-size:.96rem;}
  .ea-gallery {list-style:none;padding:0;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.25rem;}
  .ea-gallery li {min-width:0;}.ea-gallery figure {margin:0;border:1px solid #dce5ef;border-radius:1.1rem;overflow:hidden;background:#fff;}
  .ea-gallery a {display:block;}
  .ea-gallery-image {height:280px;background:#eef3fa;display:flex;align-items:center;justify-content:center;padding:.75rem;}
  .ea-gallery-image img {object-fit:contain;width:100%;height:100%;border-radius:.4rem;transition:transform .25s ease;}
  .ea-gallery figcaption {padding:1.1rem 1.25rem;}.ea-gallery h3 {display:flex;justify-content:space-between;gap:1rem;margin:0;}.ea-gallery h3 span {flex:none;color:#24568c;}
  .ea-gallery p {color:var(--muted);font-size:.9rem;margin:.5rem 0 0;}.ea-gallery-note {font-size:.86rem;color:var(--muted);}
  .ea-workflow {padding:2rem 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line);}
  .ea-workflow ol {display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:2rem;padding:0;list-style:none;counter-reset:step;}
  .ea-workflow li {min-width:0;counter-increment:step;}.ea-workflow li::before {content:"0" counter(step);font-weight:750;color:#24568c;}.ea-workflow h3 {margin:.7rem 0;}.ea-workflow p {color:var(--muted);font-size:.95rem;}
  .ea-faq details {border-bottom:1px solid var(--line);padding:1.1rem 0;}.ea-faq summary {font-weight:700;cursor:pointer;color:var(--navy);padding:.3rem 0;}.ea-faq details p {color:var(--muted);max-width:65ch;margin:.75rem 0;}
  .ea-contact {padding:1rem 0 0;}.ea-contact .kicker {color:#24568c;}.ea-contact h2 {max-width:24ch;}.ea-contact p {color:var(--muted);max-width:62ch;}.ea-contact .button {background:#24568c;color:#fff;margin-top:.7rem;}
  a:focus-visible,summary:focus-visible {outline:3px solid #155e9b;outline-offset:5px;}
  .ea-gallery a:focus-visible {outline-offset:-3px;}
  @media(hover:hover) {.ea-features li:hover {border-color:#4a7fb6;}.ea-gallery a:hover img {transform:scale(1.02);}}
  @media(max-width:600px) {.ea-hero h1 {font-size:2.75rem;}.ea-brand {align-items:flex-start;}.ea-features,.ea-gallery {grid-template-columns:1fr;}.ea-gallery-image {height:240px;}.ea-facts {grid-template-columns:1fr;gap:1rem;}.ea-facts li {border:0;padding:0;}.ea-facts strong {font-size:1.4rem;}.ea-actions {align-items:flex-start;}.ea-primary {width:100%;}.ea-headline {font-size:1.85rem;}h2 {font-size:1.8rem;}}
  @media(prefers-reduced-motion:reduce) {.ea-features li,.ea-gallery img,.ea-hero-image {transition:none;}.ea-features li:hover,.ea-gallery a:hover img {transform:none;}.ea-hero-image {transform:none;}}
  .ea-context {margin-top:3rem;padding:1.5rem;border-left:3px solid #24568c;background:#f0f5fb;border-radius:0 1rem 1rem 0;}
  .ea-context h2 {font-size:1.5rem;}.ea-context p {max-width:75ch;line-height:1.75;color:#4c6279;}
  @media (max-width:600px) {.ea-hero h1 {font-size:clamp(2rem,9vw,3rem);}.ea-context {padding:1.2rem;}}
  @media (max-width:1000px) {
    .ea-hero {grid-template-columns:minmax(0,1fr);}
    .ea-hero-image {max-width:720px;transform:none;}
    .ea-workflow ol {grid-template-columns:minmax(0,1fr);gap:.6rem;}
  }
</style>
