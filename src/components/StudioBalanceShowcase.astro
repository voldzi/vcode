---
import ProductIcon from "./ProductIcon.astro";
import { studioCopy, studioScreenshots } from "../lib/studio-balance-showcase";
const { lang = "cs" } = Astro.props as { lang?: "cs" | "en" };
const cs = lang === "cs";
const copy = studioCopy[lang];
const demoHref = `${cs ? "/spoluprace/" : "/en/work-with-us/"}?app=studio-balance&area=private-deployment#poptavka`;
const guideHref = cs ? "/navody/studio-balance-sprava-studia/" : "/en/guides/studio-balance-managing-your-studio/";
const hero = studioScreenshots[0];
---
<header class="studio-hero">
  <div class="studio-intro">
    <div class="studio-brand"><ProductIcon id="studio-balance" size={64} /><p class="kicker">{copy.eyebrow}</p></div>
    <h1>Studio Balance</h1>
    <p class="studio-headline">{copy.headline}</p>
    <p class="studio-lead">{copy.intro}</p>
    <div class="studio-actions"><a class="button studio-primary" href={demoHref} data-collaboration-interest="true">{copy.action}<span aria-hidden="true">↗</span></a><a class="studio-link" href="#moznosti">{copy.explore}<span aria-hidden="true">↓</span></a></div>
    <p class="studio-action-note">{copy.actionNote}</p>
  </div>
  {hero && <a class="studio-hero-image" href="#ukazky" aria-label={copy.galleryTitle}><img src={hero.preview} width={hero.width} height={hero.height} alt={cs ? hero.captionCs : hero.captionEn} fetchpriority="high" decoding="async" /><span>{cs ? "Ukázka správy se smyšlenými údaji" : "Management example with fictional records"}</span></a>}
  <p class="studio-arrangement">{copy.arrangement}</p>
</header>

<ul class="studio-facts" aria-label={cs ? "Studio Balance v kostce" : "Studio Balance at a glance"}>{copy.facts.map(([value, label]) => <li><strong>{value}</strong><span>{label}</span></li>)}</ul>

<section id="moznosti" class="studio-section" aria-labelledby="studio-features-title">
  <div class="studio-section-heading"><p class="kicker">{cs ? "Možnosti správy" : "Studio management"}</p><h2 id="studio-features-title">{copy.featuresTitle}</h2><p>{copy.featuresIntro}</p></div>
  <ul class="studio-features">{copy.features.map(([title, text], index) => <li><span class="studio-feature-number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span><h3>{title}</h3><p>{text}</p></li>)}</ul>
</section>

{studioScreenshots.length > 0 && <section id="ukazky" class="studio-section" aria-labelledby="studio-gallery-title">
  <div class="studio-section-heading"><p class="kicker">{cs ? "Skutečné prostředí aplikace" : "Inside the app"}</p><h2 id="studio-gallery-title">{copy.galleryTitle}</h2><p>{copy.galleryIntro}</p></div>
  <ul class="studio-gallery">{studioScreenshots.map((shot) => <li><figure><a href={shot.src} aria-label={`${cs ? shot.titleCs : shot.titleEn} — ${copy.imageAction}`}><div class="studio-gallery-image"><img src={shot.preview} width={shot.width} height={shot.height} alt={cs ? shot.captionCs : shot.captionEn} loading="lazy" decoding="async" /></div><figcaption><h3>{cs ? shot.titleCs : shot.titleEn}<span aria-hidden="true">↗</span></h3><p>{cs ? shot.captionCs : shot.captionEn}</p></figcaption></a></figure></li>)}</ul>
  <p class="studio-gallery-note">{copy.galleryNotice}</p>
</section>}

<section class="studio-workflow studio-section" aria-labelledby="studio-workflow-title">
  <div class="studio-section-heading"><p class="kicker">{cs ? "Jak to funguje" : "How it works"}</p><h2 id="studio-workflow-title">{copy.workflowTitle}</h2></div>
  <ol>{copy.workflow.map(([title, text]) => <li><h3>{title}</h3><p>{text}</p></li>)}</ol>
  <a class="studio-link" href={guideHref}>{copy.guideAction}<span aria-hidden="true">→</span></a>
</section>

<section class="studio-section studio-faq" aria-labelledby="studio-faq-title"><div class="studio-section-heading"><h2 id="studio-faq-title">{copy.faqTitle}</h2></div>{copy.faq.map(([question, answer]) => <details><summary>{question}</summary><p>{answer}</p></details>)}</section>

<aside class="studio-reference"><div><p class="kicker">{copy.referenceEyebrow}</p><h2>{copy.referenceTitle}</h2><p>{copy.referenceText}</p></div><a class="studio-link" href="https://studio-balance.cz/">{copy.referenceAction}<span aria-hidden="true">↗</span></a></aside>

<section class="studio-contact" aria-labelledby="studio-contact-title"><p class="kicker">{cs ? "Vaše studio a VCode" : "Your studio and VCode"}</p><h2 id="studio-contact-title">{copy.contactTitle}</h2><p>{copy.contactText}</p><a class="button" href={demoHref} data-collaboration-interest="true">{copy.contactAction}<span aria-hidden="true">→</span></a></section>

<style>
  :global(.product-detail.studio-balance-detail) {padding-top:clamp(1.5rem,3vw,2.5rem);}
  :global(.studio-balance-detail>.back-link) {margin-bottom:1.25rem;}
  :global(.product-detail.studio-balance-detail header) {max-width:none;}
  .studio-hero {display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,.9fr);gap:2rem;max-width:none;padding:clamp(1.5rem,4vw,3.5rem);background:linear-gradient(125deg,#fff8f4,#f9edf3 60%,#edf4f6);border:1px solid #e6d6df;border-radius:2rem;}
  .studio-intro {min-width:0;grid-column:1;}
  .studio-hero p {overflow-wrap:anywhere;}
  .studio-brand {display:flex;align-items:center;gap:1rem;margin-bottom:1.5rem;}
  .studio-brand .kicker {margin:0;color:#854663;font-size:.72rem;max-width:24rem;}
  .studio-hero h1 {font-size:clamp(2.5rem,5vw,4.5rem);line-height:1.05;overflow-wrap:anywhere;}
  .studio-headline {font:750 clamp(1.65rem,2.7vw,2.8rem)/1.15 "Manrope Variable",sans-serif;letter-spacing:-.04em;color:#824461;margin:1rem 0;}
  .studio-lead {font-size:1.06rem;line-height:1.75;max-width:48ch;color:#485765;}
  .studio-actions {display:flex;flex-wrap:wrap;align-items:center;gap:1.1rem;margin-top:1.6rem;}
  .studio-primary {background:#854663;color:#fff;}
  .studio-hero .button,.studio-contact .button {max-width:100%;min-width:0;overflow-wrap:anywhere;}
  .studio-action-note {font-size:.88rem;color:#5f5360;max-width:48ch;}
  .studio-link {display:inline-flex;align-items:center;gap:.7rem;font-weight:700;color:#854663;min-height:44px;line-height:1.5;text-decoration:underline;text-underline-offset:.25em;}
  .studio-link span {flex:none;}
  .studio-hero-image {align-self:center;background:#fff;border:1px solid #e6d6df;border-radius:1rem;padding:.5rem;box-shadow:0 24px 50px #69364b1a;transform:rotate(2deg);transition:transform .3s ease;}
  .studio-hero-image img {border-radius:.6rem;width:100%;height:auto;}
  .studio-hero-image>span {display:block;text-align:center;color:#5f5360;font-size:.78rem;padding:.65rem .3rem .25rem;}
  .studio-arrangement {grid-column:1/-1;margin:0;padding-top:1.3rem;border-top:1px solid #dac5d0;color:#5f5360;font-size:.92rem;}
  .studio-facts {list-style:none;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));padding:1.8rem 0;margin:0;border-bottom:1px solid var(--line);}
  .studio-facts li {display:flex;flex-direction:column;gap:.2rem;padding:.5rem 1.5rem;border-right:1px solid var(--line);}
  .studio-facts li:first-child {padding-left:0;}.studio-facts li:last-child {border:0;}
  .studio-facts strong {font:750 clamp(1.3rem,2vw,1.85rem)/1.2 "Manrope Variable",sans-serif;color:#854663;}
  .studio-facts span {font-size:.9rem;color:var(--muted);}
  .studio-section {margin-top:clamp(3rem,6vw,5rem);scroll-margin-top:7rem;}
  .studio-section-heading {max-width:48rem;margin-bottom:1.75rem;}
  h2 {font:750 clamp(1.7rem,3.2vw,3rem)/1.15 "Manrope Variable",sans-serif;letter-spacing:-.04em;color:var(--navy);margin:.5rem 0 1rem;overflow-wrap:anywhere;}
  h3 {font:720 1.08rem/1.4 "Manrope Variable",sans-serif;color:var(--navy);overflow-wrap:anywhere;}
  .studio-section-heading>p:last-child {color:var(--muted);max-width:60ch;}
  .studio-features {list-style:none;padding:0;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem;}
  .studio-features li {position:relative;padding:1.6rem 1.6rem 1.2rem;background:#fff;border:1px solid #e8dce2;border-radius:1.15rem;transition:transform .2s ease,border-color .2s ease;}
  .studio-feature-number {display:block;font-size:.78rem;font-weight:750;color:#854663;margin-bottom:.8rem;}
  .studio-features h3 {margin:0 0 .65rem;}.studio-features p {color:var(--muted);margin:0;line-height:1.7;font-size:.96rem;}
  .studio-gallery {list-style:none;padding:0;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.25rem;}
  .studio-gallery li {min-width:0;}.studio-gallery figure {margin:0;border:1px solid #e8dce2;border-radius:1.1rem;overflow:hidden;background:#fff;}
  .studio-gallery a {display:block;}
  .studio-gallery-image {height:280px;background:#f0e9ef;display:flex;align-items:center;justify-content:center;padding:.75rem;}
  .studio-gallery-image img {object-fit:contain;width:100%;height:100%;border-radius:.4rem;transition:transform .25s ease;}
  .studio-gallery figcaption {padding:1.1rem 1.25rem;}.studio-gallery h3 {display:flex;justify-content:space-between;gap:1rem;margin:0;}.studio-gallery h3 span {color:#854663;}
  .studio-gallery p {color:var(--muted);font-size:.9rem;margin:.5rem 0 0;}.studio-gallery-note {font-size:.86rem;color:var(--muted);}
  .studio-workflow {padding:clamp(1.5rem,3vw,2.5rem);border-radius:1.5rem;background:#edf2f7;}
  .studio-workflow ol {display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:2rem;padding:0;list-style:none;counter-reset:step;}
  .studio-workflow li {counter-increment:step;}.studio-workflow li::before {content:"0" counter(step);font-weight:750;color:#854663;}.studio-workflow h3 {margin:.7rem 0;}.studio-workflow p {color:var(--muted);font-size:.95rem;}
  .studio-faq details {border-bottom:1px solid var(--line);padding:1.1rem 0;}.studio-faq summary {font-weight:700;cursor:pointer;color:var(--navy);padding:.3rem 0;}.studio-faq details p {color:var(--muted);max-width:65ch;margin:.75rem 0;}
  .studio-reference {display:flex;align-items:center;justify-content:space-between;gap:2rem;margin:3rem 0;padding:1.5rem 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line);}.studio-reference h2 {font-size:1.45rem;}.studio-reference p:last-child {max-width:60ch;color:var(--muted);margin:0;}.studio-reference>.studio-link {flex:none;}
  .studio-contact {background:#30243a;color:#fff;border-radius:1.5rem;padding:clamp(1.5rem,4vw,3rem);}.studio-contact .kicker {color:#edd3e3;}.studio-contact h2 {color:#fff;max-width:22ch;}.studio-contact p {color:#e5d9e4;max-width:62ch;}.studio-contact .button {background:#fff;color:#633d55;margin-top:.7rem;}
  a:focus-visible,summary:focus-visible {outline:3px solid #155e9b;outline-offset:5px;}
  @media(hover:hover) {.studio-features li:hover {transform:translateY(-3px);border-color:#a35678;}.studio-gallery a:hover img {transform:scale(1.02);}.studio-hero-image:hover {transform:rotate(0);}}
  @media(max-width:1000px) {.studio-hero {grid-template-columns:1fr;}.studio-hero-image {max-width:640px;transform:none;}.studio-workflow ol {grid-template-columns:1fr;gap:.5rem;}.studio-reference {display:block;}.studio-reference>.studio-link {margin-top:.75rem;}}
  @media(max-width:600px) {.studio-hero {border-radius:1.25rem;}.studio-brand {align-items:flex-start;}.studio-features,.studio-gallery {grid-template-columns:1fr;}.studio-gallery-image {height:240px;}.studio-facts {grid-template-columns:1fr;gap:1rem;}.studio-facts li {border:0;padding:0;}.studio-facts strong {font-size:1.4rem;}.studio-actions {align-items:flex-start;}.studio-primary {width:100%;}.studio-headline {font-size:1.85rem;}.studio-reference>.studio-link {max-width:100%;}}
  @media(prefers-reduced-motion:reduce) {.studio-features li,.studio-gallery img,.studio-hero-image {transition:none;}.studio-features li:hover,.studio-gallery a:hover img {transform:none;}}
</style>
