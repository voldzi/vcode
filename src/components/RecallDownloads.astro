---
import { getRecallRelease } from "../lib/recallRelease";
const { lang = "cs" } = Astro.props as { lang?: "cs" | "en" };
const cs = lang === "cs";
const release = getRecallRelease();
const format = new Intl.NumberFormat(cs ? "cs-CZ" : "en-GB", { maximumFractionDigits: 1 });
const checkLabels: Record<string, string> = cs
  ? { cleanInstall: "čistá instalace", quarantineLaunch: "první spuštění na novém účtu s karanténou", rollback: "návrat ke starší verzi", removal: "odinstalace" }
  : { cleanInstall: "clean installation", quarantineLaunch: "first quarantined launch on a new account", rollback: "rollback to an earlier version", removal: "uninstallation" };
---
{release && <section class="detail-support recall-downloads" aria-labelledby="recall-download-title">
  <h2 id="recall-download-title">{cs ? "VCode Recall pro Mac" : "VCode Recall for Mac"}</h2>
  <p>{cs ? "Zdarma. Apple Silicon · macOS" : "Free. Apple Silicon · macOS"} {release.minimumSystemVersion}+</p>
  <p>{cs ? "Verze" : "Version"} {release.version} · {cs ? "sestava" : "build"} {release.buildNumber}</p>
  {release.validation && <details class="download-validation"><summary>{cs ? "Rozsah ověření tohoto vydání" : "Validation scope for this release"}</summary>
    <p>{cs ? "Ověřili jsme aktualizaci pod stávajícím účtem se zachováním dat a nastavení, místní start bez stahování závislostí a modelu, automatický start, připojení MCP, vyhledávání a české i anglické jazykové prostředky." : "We verified an update in an existing account with data and settings preserved, local startup without downloading dependencies or a model, automatic startup, MCP connectivity, retrieval and Czech and English language resources."}</p>
    {release.validation.notRunChecks.length > 0 && <p>{cs ? "V tomto vydání nebyly provedeny tyto instalační scénáře:" : "The following installation scenarios were not run for this release:"} {release.validation.notRunChecks.map(check => checkLabels[check]).join(", ")}.</p>}
  </details>}
  <div class="recall-files">{release.artifacts.map(artifact => <article><h3>{artifact.file.endsWith(".dmg") ? (cs ? "Instalátor DMG" : "DMG installer") : (cs ? "Archiv ZIP" : "ZIP archive")}</h3><p>{format.format(artifact.sizeBytes / 1048576)} MiB</p><a class="button primary" href={artifact.url} data-recall-download download rel="noreferrer">{cs ? "Stáhnout zdarma" : "Download for free"} <span aria-hidden="true">↓</span></a><details><summary>{cs ? "Ověření SHA-256" : "SHA-256 verification"}</summary><code>{artifact.sha256}</code></details></article>)}</div>
  <section class="download-compliance" id="recall-compliance" aria-labelledby="recall-compliance-title">
    <h3 id="recall-compliance-title">{cs ? "Licence a odpovídající zdroje" : "Licences and corresponding sources"}</h3>
    <p>{cs ? `Podklady pro verzi ${release.version}, sestavu ${release.buildNumber}. Vlastní aplikační kód VCode Recall je proprietární; otevřené součásti mají vlastní licence. Přehled uvádí jejich přesné verze a licence. Zdrojové archivy obsahují odpovídající zdroje a případné změny pokrytých součástí, včetně podkladů požadovaných MPL. Tyto soubory jsou zdarma a bez přihlášení; nejde o zdrojový repozitář celé aplikace.` : `Materials for version ${release.version}, build ${release.buildNumber}. VCode Recall's own application code is proprietary; open source components retain their licences. The inventory lists their exact versions and licences. Source archives contain the corresponding sources and any changes to covered components, including materials required by the MPL. These files are free of charge without signing in; they are not the entire application's source repository.`}</p>
    <ul>{release.complianceArtifacts.map(artifact => <li><a class="text-link" href={artifact.url} download rel="noreferrer">{artifact.kind === "source" ? (cs ? "Stáhnout odpovídající zdroje" : "Download corresponding sources") : (cs ? "Stáhnout přehled a licence součástí" : "Download component inventory and licences")}</a><small>{artifact.file} · {format.format(artifact.sizeBytes / 1048576)} MiB</small><details><summary>SHA-256</summary><code>{artifact.sha256}</code></details></li>)}</ul>
  </section>
  <p class="download-evidence"><a class="text-link" href={release.manifestURL}>{cs ? "Manifest této verze" : "This release manifest"} →</a></p>
  <p><a href={cs ? '/vcode-recall/privacy/' : '/en/vcode-recall/privacy/'}>{cs ? 'Soukromí' : 'Privacy'}</a> · <a href={cs ? '/vcode-recall/terms/' : '/en/vcode-recall/terms/'}>{cs ? 'Podmínky' : 'Terms'}</a></p>
  <p>{cs ? "Kliknutí ke stažení měříme souhrnně bez identifikace návštěvníka; respektujeme DNT a GPC. Licence součástí jsou součástí ověřeného balíčku." : "Download clicks are counted in aggregate without identifying visitors; DNT and GPC are respected. Component licences are included in the accepted package."}</p>
</section>}
{release && <script is:inline defer src="/recall-downloads.js"></script>}
<style>
  .recall-downloads { min-width:0; overflow-wrap:anywhere; border:1px solid var(--line); border-radius:1rem; padding:1.5rem; background:#f0f8f7; }
  .recall-downloads .text-link { width:auto; max-width:100%; flex-wrap:wrap; }
  .recall-files { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:1rem; margin:1.5rem 0; }
  .recall-files article { background:#fff; border:1px solid var(--line); border-radius:.8rem; padding:1.25rem; min-width:0; }
  .recall-downloads code { display:block; font-size:.75rem; overflow-wrap:anywhere; margin-top:.7rem; }
  .download-compliance a { overflow-wrap:anywhere; }
  .download-compliance { border-top:1px solid var(--line); margin-top:1.75rem; padding-top:1.25rem; }
  .download-compliance ul { list-style:none; padding:0; display:grid; gap:1rem; }
  .download-compliance li { min-width:0; padding:1rem; border:1px solid var(--line); border-radius:.75rem; background:#fff; }
  .download-compliance small { display:block; margin:.5rem 0; color:var(--muted); overflow-wrap:anywhere; }
  .recall-files details { margin-top:1rem; }
  .recall-files summary { cursor:pointer; }
  @media (max-width:700px) { .recall-files { grid-template-columns:1fr; } .recall-downloads,.recall-files article { padding:clamp(16px,4vw,28px); } }
</style>
