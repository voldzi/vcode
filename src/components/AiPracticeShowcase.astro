---
import ProductIcon from "./ProductIcon.astro";
const { lang = "cs" } = Astro.props as { lang?: "cs" | "en" };
const cs = lang === "cs";
const destination = "https://games.zeleznalady.cz/prezentaceAI/";
const c = cs ? {
  eyebrow: "Méně teorie. Více vlastní zkušenosti.", headline: "Vyzkoušejte si, co vám AI ulehčí v práci.",
  intro: "Přiložte dokument. Vyberte zadání. Ověřte odpověď. V klidu si osvojte postup, který potom použijete ve svém Copilotu.",
  action: "Vyzkoušet cvičebnu", explore: "Nahlédnout dovnitř", note: "V prohlížeči, vlastním tempem. Začít můžete bez účtu.",
  boundary: "Příběhy a dokumenty jsou vymyšlené, odpovědi připravené předem. Jde o nezávislou cvičebnu, nikoli živou AI ani službu Microsoftu.",
  facts: [["9", "pracovních příběhů"], ["196", "připravených dokumentů"], ["400", "odpovědí k prozkoumání"]],
  title: "Od prvního zadání k vlastnímu úsudku.", lead: "Zkuste si běžné situace z pracovního dne. Sledujte, co odpověď skutečně dokládá — a na co se ještě potřebujete zeptat.",
  features: [["S dokumentem v ruce", "Porovnejte nabídky dodavatelů, připravte pracovní setkání nebo vyřiďte požadavek klienta. Každý příběh má čtyři věcně odlišné varianty."], ["Odpověď, kterou prověříte", "Projděte si cvičný rozhovor, vraťte se k podkladu a rozlište potvrzený údaj od návrhu nebo chybějící informace."], ["Postup pro vaši práci", "Průvodce vás provede zadáním i ověřením. Vlastní pracovní zápis vám pomůže formulovat, co si chcete odnést do praxe."]],
  gallery: "Podívejte se, s čím budete pracovat.", galleryLead: "Přehledný začátek a dokumenty, ke kterým se můžete kdykoli vrátit.", home: "Začněte prvním příběhem", homeCaption: "Úvod vás dovede od připraveného dokumentu k ověření odpovědi.", doc: "Podklady i na telefonu", docCaption: "Čtěte zadání v souvislostech a ověřujte odpověď podle konkrétních údajů.",
  stepsTitle: "Tři kroky. Jeden užitečný návyk.", steps: [["Přiložte podklad", "Vyberte pracovní příběh a otevřete připravený dokument. Vlastní soubory se do cvičebny nenahrávají."], ["Vyberte zadání", "S průvodcem si projděte cvičný rozhovor. Animaci můžete pozastavit nebo odpověď rovnou zobrazit."], ["Ověřte závěr", "Vraťte se ke zdroji, pojmenujte nejasnosti a připravte si vlastní zadání pro svého schváleného Copilota."]],
  faqTitle: "Než začnete", faq: [["Potřebuji účet nebo předplatné Copilotu?", "Cvičit můžete jako host, bez připojení k Copilotu či AI službě. Pro dobrovolné uložení práce slouží přezdívka a soukromý návratový kód. Kód si bezpečně uschovejte — umožňuje otevřít vaši práci."], ["Mohu cvičit na telefonu a bez připojení?", "Cvičebnu lze přidat na plochu. Po prvním načtení jsou veřejné příklady dostupné offline; přílohy po výslovném stažení. Osobní uložení a návrat k němu vyžadují připojení."], ["Odpovídá mi skutečná umělá inteligence?", "Ne. Odpovědi jsou připravené pro konkrétní příběhy. Cílem je procvičit zadávání, práci s podklady a vlastní kontrolu, ne získat odpověď živého modelu."]],
  finalTitle: "Vyzkoušejte první pracovní příběh.", finalText: "Na začátku nemusíte znát správné zadání. Od toho je tu cvičebna.", guide: "Krátký návod", open: "Otevřít snímek"
} : {
  eyebrow: "Less theory. More hands-on practice.", headline: "Discover how AI can help with everyday work.",
  intro: "Attach a document. Choose an instruction. Check the response. Build a habit you can later use in your own Copilot.",
  action: "Try the Czech practice app", explore: "Take a look inside", note: "In your browser, at your pace. No account is needed to start. The app and documents are in Czech.",
  boundary: "Stories and documents are fictional; responses are prepared in advance. This independent practice app is not live AI or a Microsoft service.",
  facts: [["9", "workplace stories"], ["196", "prepared documents"], ["400", "responses to explore"]],
  title: "From a first instruction to your own judgement.", lead: "Try familiar workplace situations. See what a response actually supports — and what you still need to ask.",
  features: [["Start with a document", "Compare supplier quotes, plan a meeting or handle a customer request. Each story comes with four meaningfully different variants."], ["Check the response", "Follow a practice conversation, return to the source and distinguish a confirmed fact from a proposal or missing information."], ["Take the habit to work", "Guidance takes you through instructions and checks. Your own working notes help you put what you learn into words."]],
  gallery: "See what you will work with.", galleryLead: "A clear starting point and source documents you can return to. Screenshots show the Czech interface.", home: "Start your first story", homeCaption: "The introduction takes you from a prepared document to checking a response.", doc: "Documents on your phone", docCaption: "Read instructions in context and check a response against specific facts.",
  stepsTitle: "Three steps. One useful habit.", steps: [["Attach the source", "Choose a workplace story and open its prepared document. The app does not upload your own files."], ["Choose an instruction", "Follow the guided practice conversation. Pause the animation or reveal the complete response whenever you want."], ["Check the conclusion", "Return to the source, identify uncertainties and prepare an instruction for your own approved Copilot."]],
  faqTitle: "Before you start", faq: [["Do I need an account or a Copilot subscription?", "You can practise as a guest, without connecting to Copilot or an AI service. Optional saved work uses a nickname and private return code. Keep the code safe: it grants access to your work."], ["Can I practise on my phone and offline?", "You can add the app to your home screen. Public examples work offline after an initial visit; attachments after you explicitly download them. Saving and retrieving personal work requires a connection."], ["Is an actual AI answering me?", "No. Responses are prepared for the specific stories. The purpose is to practise instructions, source use and your own checks, rather than obtain an answer from a live model."]],
  finalTitle: "Try your first workplace story.", finalText: "You do not need to know the perfect instruction before you start. That is what practice is for.", guide: "Quick start guide", open: "Open screenshot"
};
---
<header class="ai-hero">
  <div class="ai-intro">
    <div class="ai-brand"><ProductIcon id="ai-v-praci" size={56} /><p class="kicker">{c.eyebrow}</p></div>
    <h1>AI v práci</h1><p class="ai-headline">{c.headline}</p><p class="ai-lead">{c.intro}</p>
    <div class="ai-actions"><a class="button ai-primary" href={destination} data-ai-practice="true">{c.action}<span aria-hidden="true">↗</span></a><a class="ai-link" href="#ukazky">{c.explore}<span aria-hidden="true">↓</span></a></div><p class="ai-note">{c.note}</p>
  </div>
  <a class="ai-hero-image" href="#ukazky" aria-label={c.gallery}><img src="/images/ai-v-praci/01-overview.webp" width="1280" height="720" alt={c.homeCaption} fetchpriority="high" decoding="async" /></a>
  <p class="ai-boundary">{c.boundary}</p>
</header>
<ul class="ai-facts" aria-label={cs ? "Cvičebna v kostce" : "The practice app at a glance"}>{c.facts.map(([value,label])=><li><strong>{value}</strong><span>{label}</span></li>)}</ul>
<section class="ai-section" aria-labelledby="ai-features"><p class="kicker">{cs ? "Pro běžný pracovní den" : "For everyday work"}</p><h2 id="ai-features">{c.title}</h2><p class="ai-lead">{c.lead}</p><ul class="ai-features">{c.features.map(([title,text],i)=><li><span class="ai-number" aria-hidden="true">0{i+1}</span><h3>{title}</h3><p>{text}</p></li>)}</ul></section>
<section id="ukazky" class="ai-section" aria-labelledby="ai-gallery"><h2 id="ai-gallery">{c.gallery}</h2><p class="ai-lead">{c.galleryLead}</p><div class="ai-gallery">
<figure><a href="/images/ai-v-praci/01-overview.webp" aria-label={`${c.home} — ${c.open}`}><img src="/images/ai-v-praci/01-overview-preview.webp" width="1280" height="720" alt={c.homeCaption} loading="lazy" decoding="async" /><figcaption><h3>{c.home}<span aria-hidden="true"> ↗</span></h3><p>{c.homeCaption}</p></figcaption></a></figure>
<figure class="ai-phone"><a href="/images/ai-v-praci/02-document.webp" aria-label={`${c.doc} — ${c.open}`}><div class="ai-phone-frame"><img src="/images/ai-v-praci/02-document-preview.webp" width="390" height="844" alt={c.docCaption} loading="lazy" decoding="async" /></div><figcaption><h3>{c.doc}<span aria-hidden="true"> ↗</span></h3><p>{c.docCaption}</p></figcaption></a></figure>
</div></section>
<section class="ai-section ai-workflow" aria-labelledby="ai-workflow"><h2 id="ai-workflow">{c.stepsTitle}</h2><ol>{c.steps.map(([title,text])=><li><h3>{title}</h3><p>{text}</p></li>)}</ol><a class="ai-link" href={cs ? "/navody/ai-v-praci-prvni-kroky/" : "/en/guides/ai-v-praci-getting-started/"}>{c.guide} →</a></section>
<section class="ai-section ai-faq" aria-labelledby="ai-faq"><h2 id="ai-faq">{c.faqTitle}</h2>{c.faq.map(([question,answer])=><details><summary>{question}</summary><p>{answer}</p></details>)}</section>
<section class="ai-final" aria-labelledby="ai-final"><p class="kicker">{cs ? "Zkuste to na vlastní zkušenost" : "Find out through practice"}</p><h2 id="ai-final">{c.finalTitle}</h2><p>{c.finalText}</p><a class="button ai-primary" href={destination} data-ai-practice="true">{c.action}<span aria-hidden="true">↗</span></a></section>
<script is:inline src="/ai-practice-clicks.v1.js" integrity="sha384-NDNqTLkkP53bC0g++YaBCpZV0Yp4N1Ma9ybaru0hZ+qwUuZumbFabi6hFqznAVq7" crossorigin="anonymous" defer></script>
<style>
.ai-hero{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:2rem;max-width:none!important}.ai-intro{min-width:0}.ai-brand{display:flex;gap:1rem;align-items:center;margin-bottom:1.5rem}.ai-brand .kicker{margin:0;color:#335f59;font-size:.72rem}.ai-hero h1{font-size:clamp(2.8rem,5vw,4.4rem);line-height:1.06;letter-spacing:-.035em}.ai-headline{font:750 clamp(1.7rem,3vw,2.6rem)/1.22 "Manrope Variable",sans-serif;color:#255b50;letter-spacing:-.025em;margin:1rem 0}.ai-lead{font-size:1.08rem;line-height:1.75;color:var(--muted);max-width:63ch}.ai-hero-image{align-self:center;min-width:0;display:block;box-shadow:0 20px 65px #16355718;border:1px solid #d5e2e0;border-radius:1.25rem;overflow:hidden;transform:rotate(-1deg)}.ai-hero-image img{width:100%;height:auto;display:block}.ai-actions{display:flex;gap:1rem;align-items:center;flex-wrap:wrap;margin-top:1.5rem}.ai-primary{background:#1f3c61;color:white;border:1px solid #1f3c61;min-height:48px;white-space:normal;max-width:100%;text-align:center}.ai-link{display:inline-flex;align-items:center;gap:.7rem;color:#255b50;font-weight:700;min-height:44px;text-decoration:underline;text-underline-offset:.25em}.ai-note{font-size:.86rem;line-height:1.7;color:var(--muted);max-width:58ch}.ai-boundary{grid-column:1/-1;border-top:1px solid #d1deda;padding-top:1.2rem;font-size:.9rem;color:var(--muted);line-height:1.7;margin:0}.ai-facts{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));list-style:none;padding:1.75rem 0;margin:1rem 0 0;border-bottom:1px solid var(--line);gap:1.5rem}.ai-facts li{display:flex;flex-direction:column;gap:.25rem}.ai-facts strong{font:750 2rem/1.2 "Manrope Variable",sans-serif;color:#255b50}.ai-facts span{font-size:.9rem;color:var(--muted)}.ai-section{margin-top:clamp(3rem,6vw,5rem);scroll-margin-top:7rem}h2{font:750 clamp(1.6rem,3.5vw,2.6rem)/1.25 "Manrope Variable",sans-serif;letter-spacing:-.025em;color:var(--navy);max-width:25ch;margin:.5rem 0 1.2rem}h3{font:750 1.12rem/1.4 "Manrope Variable",sans-serif;color:var(--navy)}p,h1,h2,h3,a,summary{overflow-wrap:anywhere}.ai-features{list-style:none;padding:0;margin:2rem 0 0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1.25rem}.ai-features li{min-width:0;padding:1.5rem;border:1px solid #d8e3e0;background:linear-gradient(145deg,#fff,#eef5f1);border-radius:1.25rem}.ai-number{font-weight:800;color:#255b50}.ai-features p,.ai-workflow p,.ai-faq p{font-size:1rem;line-height:1.75;color:var(--muted)}.ai-gallery{display:grid;grid-template-columns:minmax(0,1.6fr) minmax(0,1fr);gap:1.5rem;margin-top:2rem;align-items:start}.ai-gallery figure{margin:0;min-width:0;padding:1rem;border:1px solid var(--line);border-radius:1.4rem;background:white}.ai-gallery figure>a{display:block;text-decoration:none}.ai-gallery img{width:100%;height:auto;display:block;border-radius:.7rem}.ai-gallery figcaption{padding:.5rem .5rem 0}.ai-gallery figcaption p{line-height:1.7;color:var(--muted);font-size:.95rem}.ai-phone-frame{padding:1rem;background:linear-gradient(135deg,#e4ece8,#ebe8f4);border-radius:.7rem}.ai-phone-frame img{max-width:230px;margin:auto;box-shadow:0 6px 24px #1f3c6120}.ai-workflow ol{padding-left:1.4rem;max-width:70ch}.ai-workflow li{padding-left:.5rem;margin:1.5rem 0}.ai-workflow li::marker{color:#255b50;font-weight:800}.ai-faq{max-width:55rem}.ai-faq details{border-bottom:1px solid var(--line);padding:1.1rem 0}.ai-faq summary{font-weight:750;cursor:pointer;min-height:44px;display:list-item;color:var(--navy)}.ai-final{margin-top:4rem;padding:clamp(1.5rem,4vw,3rem);border-radius:1.75rem;background:linear-gradient(120deg,#e4eee8,#eceaf7);border:1px solid #d4e2da}.ai-final p{color:var(--muted);max-width:60ch;line-height:1.7}.ai-final .ai-primary{margin-top:1rem}.ai-primary:focus-visible,.ai-link:focus-visible,.ai-gallery a:focus-visible,.ai-hero-image:focus-visible,summary:focus-visible{outline:3px solid #176ab0;outline-offset:5px}
@media(hover:hover) and (prefers-reduced-motion:no-preference){.ai-primary,.ai-features li,.ai-hero-image{transition:transform .2s ease,box-shadow .2s ease}.ai-primary:hover{transform:translateY(-2px);box-shadow:0 8px 18px #1f3c6126}.ai-features li:hover{transform:translateY(-3px)}.ai-hero-image:hover{transform:rotate(0deg)}}
@media(max-width:850px){.ai-hero{grid-template-columns:minmax(0,1fr)}.ai-hero-image{transform:none;max-width:760px}.ai-features{grid-template-columns:minmax(0,1fr)}.ai-gallery{grid-template-columns:minmax(0,1fr)}.ai-phone-frame img{max-width:260px}.ai-phone-frame{padding:1rem}.ai-facts{gap:1rem}.ai-facts strong{font-size:1.7rem}.ai-facts span{font-size:.82rem}}
@media(max-width:430px){.ai-brand{align-items:flex-start}.ai-actions{align-items:stretch;flex-direction:column}.ai-actions .ai-link{align-self:flex-start}.ai-facts{gap:.65rem}.ai-final{border-radius:1.1rem}.ai-gallery figure{padding:.65rem}}
</style>
