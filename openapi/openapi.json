{
  "openapi": "3.1.0",
  "info": {
    "title": "VCode public and authenticated API",
    "version": "1.3.0",
    "description": "Health, moderated comments, minimal public analytics collection and authenticated portfolio metrics. Prepared, disabled-by-default Recall distribution and private aggregate counters."
  },
  "servers": [
    {
      "url": "https://vcode.zeleznalady.cz"
    }
  ],
  "paths": {
    "/health/blog": {
      "get": {
        "operationId": "getBlogHealth",
        "responses": {
          "200": {
            "description": "Blog service and database are ready",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "500": {
            "description": "Dependency is unavailable"
          }
        }
      }
    },
    "/api/blog/{slug}/comments": {
      "post": {
        "operationId": "submitBlogComment",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9-]+$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "body",
                  "lang"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 60
                  },
                  "email": {
                    "type": "string",
                    "format": "email",
                    "maxLength": 160
                  },
                  "body": {
                    "type": "string",
                    "minLength": 10,
                    "maxLength": 2000
                  },
                  "lang": {
                    "type": "string",
                    "enum": [
                      "cs",
                      "en"
                    ]
                  },
                  "website": {
                    "type": "string",
                    "description": "Spam honeypot; normal clients leave it empty."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "303": {
            "description": "Comment accepted and redirected to the article"
          },
          "400": {
            "description": "Invalid comment"
          },
          "403": {
            "description": "Origin check failed"
          },
          "404": {
            "description": "Published article not found"
          },
          "413": {
            "description": "Request exceeds 16 KiB"
          },
          "429": {
            "description": "Per-origin rate limit reached",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer"
                }
              }
            }
          }
        }
      }
    },
    "/api/blog/telegram/webhook": {
      "post": {
        "operationId": "receiveTelegramEditorialUpdate",
        "description": "Private Telegram callback receiver. It is unavailable while editorial integration is disabled.",
        "parameters": [
          {
            "name": "X-Telegram-Bot-Api-Secret-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 32
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "update_id"
                ],
                "properties": {
                  "update_id": {
                    "type": "integer"
                  }
                },
                "additionalProperties": true
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Update accepted or already processed"
          },
          "403": {
            "description": "Webhook secret is invalid"
          },
          "404": {
            "description": "Integration is disabled"
          },
          "413": {
            "description": "Request exceeds 64 KiB"
          }
        }
      }
    },
    "/analytics/event": {
      "post": {
        "operationId": "collectPublicAnalytics",
        "responses": {
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Origin not allowed"
          },
          "429": {
            "description": "Rate limit exceeded"
          },
          "502": {
            "description": "Analytics dependency unavailable"
          },
          "204": {
            "description": "Event accepted or collection disabled"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "website",
                  "name",
                  "url"
                ],
                "properties": {
                  "website": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "name": {
                    "type": "string",
                    "enum": [
                      "pageview",
                      "app-store-click",
                      "contact-click"
                    ]
                  },
                  "url": {
                    "type": "string",
                    "maxLength": 2000
                  },
                  "referrer": {
                    "type": "string",
                    "maxLength": 2000
                  }
                }
              }
            }
          }
        }
      }
    },
    "/prehled/api/login": {
      "post": {
        "operationId": "loginMetrics",
        "responses": {
          "200": {
            "description": "Request completed"
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Origin not allowed"
          },
          "429": {
            "description": "Rate limit exceeded"
          },
          "502": {
            "description": "Analytics dependency unavailable"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "username",
                  "password"
                ],
                "properties": {
                  "username": {
                    "type": "string",
                    "maxLength": 255
                  },
                  "password": {
                    "type": "string",
                    "maxLength": 255,
                    "writeOnly": true
                  }
                }
              }
            }
          }
        }
      }
    },
    "/prehled/api/logout": {
      "post": {
        "operationId": "logoutMetrics",
        "responses": {
          "200": {
            "description": "Request completed"
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Origin not allowed"
          },
          "429": {
            "description": "Rate limit exceeded"
          },
          "502": {
            "description": "Analytics dependency unavailable"
          }
        },
        "security": [
          {
            "metricsSession": []
          }
        ]
      }
    },
    "/prehled/api/summary": {
      "get": {
        "operationId": "getMetricsSummary",
        "responses": {
          "200": {
            "description": "Read-only aggregates for authorized registered public websites. Unavailable sites have null stats; daily nulls mean missing coverage. Prior-period comparison uses equal duration. No provider credentials are returned.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "sites",
                    "startAt",
                    "endAt",
                    "generatedAt",
                    "sessionExpiresAt",
                    "timezone",
                    "incomplete",
                    "downloads"
                  ],
                  "properties": {
                    "startAt": {
                      "type": "integer"
                    },
                    "endAt": {
                      "type": "integer"
                    },
                    "generatedAt": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "sessionExpiresAt": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "timezone": {
                      "type": "string",
                      "enum": [
                        "Europe/Prague"
                      ]
                    },
                    "incomplete": {
                      "type": "boolean"
                    },
                    "sites": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "name",
                          "domain",
                          "available",
                          "stats",
                          "series",
                          "capabilities"
                        ],
                        "properties": {
                          "name": {
                            "type": "string"
                          },
                          "domain": {
                            "type": "string"
                          },
                          "collectionEnabled": {
                            "type": "boolean"
                          },
                          "available": {
                            "type": "boolean"
                          },
                          "stats": {
                            "type": [
                              "object",
                              "null"
                            ],
                            "additionalProperties": true
                          },
                          "series": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "date": {
                                  "type": "string",
                                  "format": "date"
                                },
                                "pageviews": {
                                  "type": [
                                    "integer",
                                    "null"
                                  ],
                                  "minimum": 0
                                }
                              }
                            }
                          },
                          "capabilities": {
                            "type": "object",
                            "properties": {
                              "referrers": {
                                "type": "boolean"
                              },
                              "events": {
                                "type": "array",
                                "items": {
                                  "type": "string"
                                }
                              }
                            }
                          }
                        }
                      }
                    },
                    "downloads": {
                      "$ref": "#/components/schemas/DownloadMetrics"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Origin not allowed"
          },
          "429": {
            "description": "Rate limit exceeded"
          },
          "502": {
            "description": "Analytics dependency unavailable"
          }
        },
        "security": [
          {
            "metricsSession": []
          }
        ],
        "parameters": [
          {
            "name": "days",
            "in": "query",
            "schema": {
              "type": "integer",
              "enum": [
                7,
                30,
                90
              ],
              "default": 7
            }
          }
        ]
      }
    },
    "/analytics/v1/tracker.js": {
      "servers": [
        {
          "url": "https://masaze.zeleznalady.cz"
        },
        {
          "url": "https://studio-balance.cz"
        },
        {
          "url": "https://cop.zeleznalady.cz"
        },
        {
          "url": "https://kaloricketabulky.zeleznalady.cz"
        },
        {
          "url": "https://mestemhrou.cz/mestem-hrou"
        }
      ],
      "get": {
        "operationId": "getPublicAnalyticsRuntimeV1",
        "description": "Versioned same-origin runtime for registered public applications; no automatic collection. VCode itself retains its legacy tracker route.",
        "security": [],
        "responses": {
          "200": {
            "description": "Pinned vcode-public-v1 JavaScript",
            "content": {
              "text/javascript": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "405": {
            "description": "Unsupported method"
          }
        }
      }
    },
    "/analytics/v1/events": {
      "servers": [
        {
          "url": "https://masaze.zeleznalady.cz"
        },
        {
          "url": "https://studio-balance.cz"
        },
        {
          "url": "https://cop.zeleznalady.cz"
        },
        {
          "url": "https://kaloricketabulky.zeleznalady.cz"
        },
        {
          "url": "https://mestemhrou.cz/mestem-hrou"
        }
      ],
      "post": {
        "operationId": "sendPublicAnalyticsPageviewV1",
        "description": "Registered site/origin and exact path only; no optional properties. Trusted edge overrides client metadata and supplies internal authorization. DNT/GPC suppress storage. No cookies or public analytics/admin access.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PublicPageviewV1"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Accepted or suppressed by privacy preference"
          },
          "400": {
            "description": "Unapproved site, incorrect origin or payload"
          },
          "405": {
            "description": "Unsupported method"
          },
          "413": {
            "description": "Payload exceeds 2 KiB"
          },
          "415": {
            "description": "JSON content type required"
          },
          "429": {
            "description": "Rate limit exceeded"
          },
          "502": {
            "description": "Analytics backend unavailable"
          }
        }
      }
    },
    "/downloads/chromadb-status/latest.json": {
      "x-release-state": "disabled-by-default",
      "get": {
        "operationId": "getRecallLatest",
        "description": "Compatibility endpoint. No redirect; direct JSON up to 65536 bytes only after accepted publication. No functional release is active in preparation.",
        "responses": {
          "200": {
            "description": "Latest accepted public release; immutable DMG download URL.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecallLatest"
                }
              }
            }
          },
          "304": {
            "description": "Unchanged cached metadata"
          },
          "404": {
            "description": "Distribution disabled, no accepted release or invalid catalog"
          }
        }
      },
      "head": {
        "operationId": "headRecallLatest",
        "responses": {
          "200": {
            "description": "Latest metadata headers only"
          },
          "404": {
            "description": "No accepted public release"
          }
        }
      }
    },
    "/downloads/chromadb-status/{release}/{file}": {
      "x-release-state": "disabled-by-default",
      "parameters": [
        {
          "name": "release",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "pattern": "^[0-9]{1,6}\\.[0-9]{1,6}\\.[0-9]{1,6}-[1-9][0-9]{0,19}$"
          }
        },
        {
          "name": "file",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "maxLength": 180
          },
          "description": "Exact immutable allowlisted file declared by the accepted catalog; no arbitrary path, query, encoded alias or symlink."
        }
      ],
      "get": {
        "operationId": "getRecallArtifact",
        "description": "Read-only immutable approved installers and OSS compliance files. Never serves build/source directories or signing material. Requests are aggregate operational counts, not installations.",
        "responses": {
          "200": {
            "description": "Exact hash-verified file or public metadata. MIME is selected from its approved installer/license/source type.",
            "headers": {
              "ETag": {
                "schema": {
                  "type": "string"
                }
              },
              "Content-Length": {
                "schema": {
                  "type": "string"
                }
              },
              "Content-Disposition": {
                "schema": {
                  "type": "string"
                }
              },
              "Accept-Ranges": {
                "schema": {
                  "const": "bytes"
                }
              }
            },
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "206": {
            "description": "One validated byte range only",
            "headers": {
              "ETag": {
                "schema": {
                  "type": "string"
                }
              },
              "Content-Length": {
                "schema": {
                  "type": "string"
                }
              },
              "Content-Disposition": {
                "schema": {
                  "type": "string"
                }
              },
              "Accept-Ranges": {
                "schema": {
                  "const": "bytes"
                }
              },
              "Content-Range": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "304": {
            "description": "ETag matched"
          },
          "404": {
            "description": "Not allowlisted or not active"
          },
          "416": {
            "description": "Unsupported or unsatisfiable byte range"
          },
          "503": {
            "description": "Artifact drift or storage failure; fail closed"
          }
        }
      },
      "head": {
        "operationId": "headRecallArtifact",
        "responses": {
          "200": {
            "description": "Approved representation headers, no body",
            "headers": {
              "ETag": {
                "schema": {
                  "type": "string"
                }
              },
              "Content-Length": {
                "schema": {
                  "type": "string"
                }
              },
              "Content-Disposition": {
                "schema": {
                  "type": "string"
                }
              },
              "Accept-Ranges": {
                "schema": {
                  "const": "bytes"
                }
              }
            }
          },
          "404": {
            "description": "Not allowlisted"
          },
          "416": {
            "description": "Unsupported range"
          },
          "503": {
            "description": "Artifact drift"
          }
        }
      }
    },
    "/analytics/download-intent": {
      "x-release-state": "disabled-by-default",
      "post": {
        "operationId": "recordRecallDownloadIntent",
        "description": "Optional anonymous aggregate download intent for an accepted active release and approved notice. Same-origin browser request only, respects DNT/GPC, no visitor cookie, identity, URLs or referrer. Aggregate retention is 30 days.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "product"
                ],
                "properties": {
                  "product": {
                    "const": "vcode-recall"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Intent accepted or privacy preference suppressed recording"
          },
          "400": {
            "description": "Invalid fixed payload"
          },
          "403": {
            "description": "Invalid origin or credential-bearing request"
          },
          "404": {
            "description": "Collection disabled at the public edge"
          },
          "413": {
            "description": "Body exceeds 128 bytes"
          },
          "503": {
            "description": "No approved active release or durable aggregate collection unavailable"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Health": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "generationEnabled"
        ],
        "properties": {
          "status": {
            "type": "string",
            "const": "ok"
          },
          "generationEnabled": {
            "type": "boolean"
          }
        }
      },
      "PublicPageviewV1": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "website",
          "name",
          "path"
        ],
        "properties": {
          "website": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "enum": [
              "pageview"
            ]
          },
          "path": {
            "type": "string",
            "pattern": "^/[a-zA-Z0-9_:/-]*$",
            "description": "Exact registered general public path, without identifiers, query or fragment."
          }
        }
      },
      "DownloadCounters": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "getRequests",
          "headRequests",
          "fullResponses",
          "rangeResponses",
          "errorResponses",
          "abortedResponses",
          "bytesWritten",
          "clickIntents"
        ],
        "properties": {
          "getRequests": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "headRequests": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "fullResponses": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "rangeResponses": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "errorResponses": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "abortedResponses": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "bytesWritten": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "clickIntents": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "description": "Numeric daily aggregates only; bytesWritten is file-body data written from the distribution service to its proxy, not client acknowledgment or installation."
      },
      "DownloadMetrics": {
        "type": "object",
        "required": [
          "availability",
          "product",
          "totals",
          "series",
          "artifacts"
        ],
        "properties": {
          "availability": {
            "type": "string",
            "enum": [
              "available",
              "unavailable"
            ]
          },
          "reason": {
            "type": "string",
            "enum": [
              "not-configured",
              "not-ready",
              "not-authorized",
              "invalid"
            ]
          },
          "product": {
            "const": "vcode-recall"
          },
          "totals": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/DownloadCounters"
              },
              {
                "type": "null"
              }
            ]
          },
          "series": {
            "type": "array",
            "maxItems": 30,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "date",
                "getRequests",
                "headRequests",
                "fullResponses",
                "rangeResponses",
                "errorResponses",
                "abortedResponses",
                "bytesWritten",
                "clickIntents"
              ],
              "properties": {
                "date": {
                  "type": "string",
                  "format": "date"
                },
                "getRequests": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "headRequests": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "fullResponses": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "rangeResponses": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "errorResponses": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "abortedResponses": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "bytesWritten": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "clickIntents": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              }
            }
          },
          "artifacts": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "object"
            }
          },
          "retentionDays": {
            "const": 30
          },
          "timezone": {
            "const": "UTC"
          },
          "measurement": {
            "const": "service-to-proxy"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "coverageStart": {
            "type": "string",
            "format": "date-time"
          },
          "metadata": {
            "$ref": "#/components/schemas/DownloadCounters"
          }
        },
        "description": "Requires a current authenticated account with permission to the canonical VCode website. Unconfigured or invalid data is unavailable with null totals. Operational counters are separate from website analytics; no visitor identities, referrers, cookies or project content."
      },
      "RecallLatest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schemaVersion",
          "version",
          "build",
          "buildNumber",
          "minimumSystemVersion",
          "platform",
          "downloadURL",
          "sha256",
          "sizeBytes",
          "distribution",
          "signing",
