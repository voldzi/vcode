# Public canonical origin used during production builds.
PUBLIC_SITE_URL=https://vcode.zeleznalady.cz

# Reserved server-side integration. The browser must never receive this URL or token.
AKB_PUBLIC_BASE_URL=
AKB_PUBLIC_DELIVERY_TOKEN_FILE=

# Optional public media publishing. The first blog release uses deterministic local artwork.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=vcode-public-media
S3_ACCESS_KEY_FILE=
S3_SECRET_KEY_FILE=

# Blog runtime. Secrets are mounted as files and never exposed to the browser.
DATABASE_URL_FILE=/run/secrets/vcode_database_url
OPENAI_API_KEY_FILE=/run/secrets/vcode_openai_api_key
BLOG_COMMENT_HASH_SECRET_FILE=/run/secrets/vcode_comment_hash_secret
BLOG_PORT=8090
BLOG_RUN_INTERVAL_MINUTES=360
BLOG_GENERATION_ENABLED=false
BLOG_AUTO_PUBLISH=false
BLOG_COMMENT_AUTO_APPROVE=false
BLOG_OPENAI_MODEL=gpt-6-luna
BLOG_AI_MAX_RUNS_PER_DAY=1
BLOG_AI_MAX_INPUT_CHARS=28000
BLOG_AI_MAX_OUTPUT_TOKENS=6000
BLOG_AI_DAILY_TOKEN_BUDGET=80000
BLOG_AI_MONTHLY_COST_USD=5
BLOG_AI_INPUT_PRICE_PER_MILLION_USD=0.10
BLOG_AI_OUTPUT_PRICE_PER_MILLION_USD=0.50
BLOG_FEED_MAX_BYTES=2000000
BLOG_FEED_MAX_ITEMS=100
BLOG_FEED_TIMEOUT_MS=15000
BLOG_FEED_MAX_REDIRECTS=3
# Telegram editorial review stays disabled until a dedicated bot token and reviewer IDs are configured.
BLOG_TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN_FILE=/run/secrets/vcode_telegram_bot_token
TELEGRAM_WEBHOOK_SECRET_FILE=/run/secrets/vcode_telegram_webhook_secret
BLOG_REVIEW_SIGNING_SECRET_FILE=/run/secrets/vcode_review_signing_secret
BLOG_TELEGRAM_CHAT_ID=
BLOG_TELEGRAM_USER_ID=
BLOG_REVIEW_TTL_HOURS=72
VCODE_BIND_ADDRESS=127.0.0.1
VCODE_PORT=3280
