# Operator template only. This file contains no credential values.
# The directory is private, owned by the service UID, and mounted only in blog.
VCODE_PARTNERSHIP_CONFIG=/private-config/vcode-partnerships
PARTNERSHIP_INTAKE_ENABLED=false
PARTNERSHIP_REGISTRY_FILE=/run/partnerships/registry.json
PARTNERSHIP_CHALLENGE_SECRET_FILE=/run/partnerships/challenge-secret
PARTNERSHIP_DASHBOARD_ENABLED=false

# Use the existing contact overlay configuration unchanged. Do not copy an
# inbox token, form secret, owner ID or internal URL into a browser build.
# CONTACT_SERVICE_URL, CONTACT_INBOX_TOKEN_FILE and CONTACT_INBOX_OWNER_ID_FILE
# continue to come from deploy/contact/analytics-overlay.yml.
